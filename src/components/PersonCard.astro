---
import { useTranslations, type Lang } from '~/i18n/utils';

interface Props {
  name: string;
  role: string;        // human-readable label, e.g. "PhD candidate" or "MSc 2025"
  title?: string;      // dissertation / thesis title
  link?: string;       // personal page, ORCID, etc.
  nowAt?: string;      // for alumni: "Now PhD student at X"
  supervisor?: string; // main supervisor when I served on the committee
  lang?: Lang;
}
const { name, role, title, link, nowAt, supervisor, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---
<article class="py-4 border-t border-rule-soft first:border-t-0">
  <p class="font-prose text-[1.125rem] leading-[1.35] text-ink">
    {link ? <a href={link}>{name}</a> : name}
  </p>
  {title && <p class="mt-1 font-prose italic text-[1rem] leading-[1.45] text-ink-muted text-pretty">{title}</p>}
  <p class="meta mt-1.5">
    {role}{supervisor && <Fragment> · {t.group.mainSupervisor} {supervisor}</Fragment>}{nowAt && <Fragment> · {nowAt}</Fragment>}
  </p>
</article>
