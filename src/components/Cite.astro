---
import { getCollection } from 'astro:content';
import { citedRefs } from '~/lib/citations';
import { postUrl } from '~/lib/posts';

/**
 * Inline citation marker, "[2]", linking to the post's reference list.
 * The number is the reference's position in that list (Bibliography.astro),
 * so the post is looked up from the page URL to read its `cited` keys.
 */
interface Props {
  key: string;
}

const { key } = Astro.props;
const post = (await getCollection('blog')).find((p) => postUrl(p) === Astro.url.pathname);
if (!post) throw new Error(`<Cite key="${key}"> used outside a blog post (${Astro.url.pathname})`);

const number = citedRefs(post.data.cited).findIndex((r) => r.id === key) + 1;
// A marker with no entry in the list would be a dead link: fail the build.
if (!number) {
  throw new Error(`${post.id}: <Cite key="${key}"> is not listed in the post's "cited" frontmatter`);
}
---
<a href={`#ref-${key}`} class="text-sm align-baseline">[{number}]</a>
