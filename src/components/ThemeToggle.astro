---
// Five-theme switcher rendered in the navbar.
//
// Each theme entry below maps to a `[data-theme="<id>"]` block in
// src/styles/global.css. To add a sixth theme, append an entry here AND a
// corresponding CSS variable block in global.css — nothing else needs to
// change.
//
// The early-init script lives in BaseLayout's <head> to avoid FOUC; this
// component owns the dropdown UI and the click-to-apply behaviour.

const THEMES = [
  { id: 'aubergine', label: 'Aubergine', swatch: '#5B3A78', bg: '#FAFAF6' },
  { id: 'dark',      label: 'Dark',      swatch: '#B79BDF', bg: '#131013' },
  { id: 'nordic',    label: 'Nordic',    swatch: '#2E5C8A', bg: '#F4F6FA' },
  { id: 'sunset',    label: 'Sunset',    swatch: '#B14F47', bg: '#FFF6EE' },
  { id: 'mono',      label: 'Mono',      swatch: '#0A0A0A', bg: '#FFFFFF' }
] as const;
---
<div class="relative" data-theme-switcher>
  <button
    type="button"
    id="theme-switcher-button"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label="Switch theme"
    class="flex items-center gap-2 px-2.5 py-1.5 rounded-full text-sm text-ink-muted hover:text-ink hover:bg-accent-primary-soft border border-rule transition-colors"
  >
    {/* Current-theme dot — JS swaps the inline background on theme change. */}
    <span
      data-theme-dot
      class="w-3 h-3 rounded-full border border-rule shrink-0"
      style="background:#5B3A78"
      aria-hidden="true"
    ></span>
    <span class="hidden sm:inline" data-theme-label>Aubergine</span>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div
    id="theme-switcher-menu"
    role="menu"
    aria-labelledby="theme-switcher-button"
    class="hidden absolute right-0 mt-2 w-44 origin-top-right bg-bg-elev border border-rule rounded-lg shadow-lg z-30 p-1"
  >
    {THEMES.map((t) => (
      <button
        type="button"
        role="menuitemradio"
        data-theme-option={t.id}
        class="w-full flex items-center gap-3 px-3 py-2 rounded-md text-sm text-ink hover:bg-accent-primary-soft cursor-pointer transition-colors"
      >
        <span
          class="w-4 h-4 rounded-full border border-rule shrink-0"
          style={`background:${t.swatch}`}
          aria-hidden="true"
        ></span>
        <span class="flex-1 text-left">{t.label}</span>
        <svg
          data-theme-check={t.id}
          class="hidden w-3.5 h-3.5 text-accent-primary"
          viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        >
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </button>
    ))}
  </div>
</div>

<script is:inline define:vars={{ THEMES }}>
  (() => {
    const root = document.documentElement;
    const wrap = document.querySelector('[data-theme-switcher]');
    const btn = document.getElementById('theme-switcher-button');
    const menu = document.getElementById('theme-switcher-menu');
    if (!wrap || !btn || !menu) return;

    const themeById = Object.fromEntries(THEMES.map((t) => [t.id, t]));
    const valid = new Set(THEMES.map((t) => t.id));

    /* Migrate legacy "light" -> "aubergine" so existing visitors don't see
       a snapped reset on first load after the multi-theme upgrade. */
    const stored = localStorage.getItem('theme');
    if (stored === 'light') localStorage.setItem('theme', 'aubergine');

    const current = () => {
      const t = root.dataset.theme || 'aubergine';
      return valid.has(t) ? t : 'aubergine';
    };

    const apply = (id) => {
      if (!valid.has(id)) return;
      root.dataset.theme = id;
      localStorage.setItem('theme', id);
      paintButton(id);
      paintMenu(id);
    };

    const paintButton = (id) => {
      const t = themeById[id];
      const dot = wrap.querySelector('[data-theme-dot]');
      const label = wrap.querySelector('[data-theme-label]');
      if (dot) dot.style.background = t.swatch;
      if (label) label.textContent = t.label;
    };

    const paintMenu = (id) => {
      menu.querySelectorAll('[data-theme-check]').forEach((el) => {
        el.classList.toggle('hidden', el.dataset.themeCheck !== id);
      });
    };

    const open = () => {
      menu.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
    };
    const close = () => {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    };

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.contains('hidden') ? open() : close();
    });

    menu.querySelectorAll('[data-theme-option]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        apply(el.dataset.themeOption);
        close();
      });
    });

    document.addEventListener('click', (e) => {
      if (!wrap.contains(e.target)) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });

    /* Paint to the current theme on load so the button & checkmark agree
       with the early-init script that set <html data-theme>. */
    paintButton(current());
    paintMenu(current());
  })();
</script>
