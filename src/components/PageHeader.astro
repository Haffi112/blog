---
/**
 * Section-page header: small-caps eyebrow, serif display title, optional
 * lede paragraph (or extra content via the default slot), hairline rule.
 */
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---
<header class="pt-12 md:pt-16 pb-8 border-b border-rule">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="mt-3 text-display-sm font-light text-ink">{title}</h1>
  {lede && (
    <p class="mt-4 font-prose text-[1.0625rem] leading-[1.6] text-ink-muted max-w-prose">{lede}</p>
  )}
  <slot />
</header>
