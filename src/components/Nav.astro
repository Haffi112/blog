---
import { languages, localizePath, otherLang, switchHref, useTranslations, type Lang } from '~/i18n/utils';

interface Props {
  lang?: Lang;
  /** The other language's twin of this page, when the page knows it (posts). */
  switchTo?: string;
}
const { lang = 'en', switchTo } = Astro.props;
const t = useTranslations(lang);
const items = [
  { href: '/research/', label: t.nav.research },
  { href: '/publications/', label: t.nav.publications },
  { href: '/teaching/', label: t.nav.teaching },
  { href: '/group/', label: t.nav.group },
  { href: '/writing/', label: t.nav.writing },
  { href: '/about/', label: t.nav.about }
].map((it) => ({ ...it, href: localizePath(it.href, lang) }));
const here = Astro.url.pathname;
/* A blog post lives at /YYYY/MM/DD/slug/ (or under /is/), outside /writing/,
   but it is still "Writing" as far as the reader is concerned. */
const isPost = /^(\/is)?\/\d{4}\/\d{2}\/\d{2}\//.test(here);
const isActive = (href: string) =>
  here === href || (href !== '/' && here.startsWith(href)) || (isPost && href.endsWith('/writing/'));

/* Language switcher: the other language's twin of this page (or its home /
   writing index when there is no twin). Labelled in its own language. */
const other = languages[otherLang(lang)];
const otherHref = switchTo ?? switchHref(here);
---
<header data-site-header class="sticky top-0 z-20 bg-bg/85 backdrop-blur-md border-b border-rule">
  <nav class="max-w-page mx-auto px-6 h-15 flex items-center justify-between gap-3">
    <!-- The wordmark is set in the display serif at its plain weight; in a
         paper design the name doesn't need bolding to read as the masthead. -->
    <a href={localizePath('/', lang)} class="font-display text-[1.0625rem] text-ink shrink-0">Hafsteinn Einarsson</a>

    <!-- Mono caps are appreciably wider than the sans they replaced, so the
         row is tuned to survive its tightest moment: 768px, where the
         desktop nav first appears and the theme switcher is still present.
         Type steps up and the CV button joins only once there is room. -->
    <ul class="hidden md:flex items-center gap-[clamp(0.75rem,1.5vw,1.625rem)] font-mono text-[0.71875rem] lg:text-[0.78125rem] uppercase tracking-[0.03em] lg:tracking-[0.04em]">
      {items.map((it) => (
        <li>
          <a
            href={it.href}
            aria-current={isActive(it.href) ? 'page' : undefined}
            class:list={[
              'transition-colors pb-1',
              isActive(it.href)
                ? 'text-ink border-b border-accent-primary'
                : 'text-ink-muted hover:text-ink'
            ]}
          >{it.label}</a>
        </li>
      ))}
      <li class="hidden lg:block">
        <a
          href="/cv.pdf"
          hreflang={lang === 'en' ? undefined : 'en'}
          class="btn-editorial px-3 py-[0.4375rem] text-[0.78125rem]"
        >{t.nav.cv}</a>
      </li>
    </ul>

    <div class="flex items-center gap-2">
      <!-- Language switcher. From md it sits beside the theme toggle,
           stretched to the toggle's height (self-stretch: the hamburger,
           the only taller item, is gone by then); below md it lives in the
           mobile menu, where there is room to spell the language out. -->
      <a
        href={otherHref}
        hreflang={other.hreflang}
        lang={other.hreflang}
        aria-label={other.name}
        title={other.name}
        class="hidden md:inline-flex self-stretch items-center px-2.5 font-mono text-[0.75rem] tracking-[0.04em] text-ink-muted hover:text-ink hover:bg-accent-primary-soft border border-rule transition-colors"
      >{other.short}</a>
      <slot name="end" />
      <button
        type="button"
        id="mobile-menu-button"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
        aria-label={t.nav.openMenu}
        data-label-open={t.nav.openMenu}
        data-label-close={t.nav.closeMenu}
        class="md:hidden inline-flex items-center justify-center w-9 h-9 border border-rule text-ink-muted hover:text-ink hover:bg-accent-primary-soft transition-colors"
      >
        <svg
          data-menu-icon="open"
          width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
        <svg
          data-menu-icon="close"
          class="hidden"
          width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu-panel"
    class="md:hidden grid transition-[grid-template-rows] duration-200 ease-out motion-reduce:transition-none"
    style="grid-template-rows: 0fr"
  >
    <div class="min-h-0 overflow-hidden">
      <ul class="border-t border-rule px-3 py-2 flex flex-col gap-0.5">
        {items.map((it) => {
          const active = isActive(it.href);
          return (
            <li>
              <a
                href={it.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'relative flex items-center min-h-11 px-4 font-mono text-[0.8125rem] uppercase tracking-[0.06em] transition-colors',
                  active
                    ? 'text-accent-primary'
                    : 'text-ink hover:text-ink hover:bg-accent-primary-soft'
                ]}
              >
                {active && (
                  <span
                    class="absolute left-1 top-2 bottom-2 w-0.5 bg-accent-primary"
                    aria-hidden="true"
                  />
                )}
                {it.label}
              </a>
            </li>
          );
        })}
        <li>
          <a
            href="/cv.pdf"
            hreflang={lang === 'en' ? undefined : 'en'}
            class="relative flex items-center min-h-11 px-4 font-mono text-[0.8125rem] uppercase tracking-[0.06em] text-ink hover:bg-accent-primary-soft transition-colors"
          >{t.nav.cv}</a>
        </li>
        <li class="border-t border-rule-soft mt-1 pt-1">
          <a
            href={otherHref}
            hreflang={other.hreflang}
            lang={other.hreflang}
            class="relative flex items-center gap-3 min-h-11 px-4 font-mono text-[0.8125rem] tracking-[0.06em] text-ink-muted hover:text-ink hover:bg-accent-primary-soft transition-colors"
          ><span class="text-ink-faint" aria-hidden="true">{other.short}</span>{other.name}</a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById('mobile-menu-button');
    const panel = document.getElementById('mobile-menu-panel');
    if (!btn || !panel) return;

    const iconOpen = btn.querySelector('[data-menu-icon="open"]');
    const iconClose = btn.querySelector('[data-menu-icon="close"]');

    const setOpen = (state) => {
      btn.setAttribute('aria-expanded', state ? 'true' : 'false');
      btn.setAttribute('aria-label', state ? btn.dataset.labelClose : btn.dataset.labelOpen);
      panel.style.gridTemplateRows = state ? '1fr' : '0fr';
      iconOpen?.classList.toggle('hidden', state);
      iconClose?.classList.toggle('hidden', !state);
    };

    const isOpen = () => btn.getAttribute('aria-expanded') === 'true';

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(!isOpen());
    });

    /* Close after tapping a link so the destination page lands clean. */
    panel.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => setOpen(false));
    });

    /* Escape closes and returns focus to the trigger. */
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        btn.focus();
      }
    });

    /* Click outside the panel + button closes. */
    document.addEventListener('click', (e) => {
      if (!isOpen()) return;
      if (panel.contains(e.target) || btn.contains(e.target)) return;
      setOpen(false);
    });

    /* If the viewport grows past md the desktop nav takes over — collapse. */
    const mq = window.matchMedia('(min-width: 768px)');
    const onChange = (e) => { if (e.matches) setOpen(false); };
    mq.addEventListener ? mq.addEventListener('change', onChange) : mq.addListener(onChange);
  })();
</script>
