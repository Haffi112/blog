---
import BaseLayout from '~/components/BaseLayout.astro';
---
<BaseLayout
  title="Not found"
  description="Page not found — Hafsteinn Einarsson's website."
>
  <section class="max-w-page mx-auto px-6 py-24 text-center">
    <p class="font-mono text-sm text-ink-muted">404</p>
    <h1 class="mt-2 text-display font-semibold tracking-tight text-ink">Not found</h1>
    <p class="mt-4 prose-body max-w-prose mx-auto">
      The page you're looking for isn't here. It might have been moved or it might never have existed.
      Try <a href="/">the home page</a>, the <a href="/publications/">publications list</a>, or my <a href="/writing/">writing</a>.
    </p>
  </section>
</BaseLayout>
