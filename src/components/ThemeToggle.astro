---
// Three-theme switcher: editorial light, editorial dark, and the
// accessibility-focused Reader theme.
//
// Swatches are determined at runtime by probing `--color-primary` on a
// hidden <div data-theme=...> element — no hardcoded hex values to drift
// out of sync with the CSS.
//
// To add a new theme:
//   1. Add a `@plugin "daisyui/theme" { name: "myname"; ... }` block in
//      src/styles/global.css and list it in the `themes:` option there.
//   2. Append { id: 'myname', label: 'My Name' } to THEMES below.
//   3. Append the id to the VALID set in BaseLayout's no-FOUC script.

const THEMES = [
  { id: 'light',  label: 'Light' },
  { id: 'dark',   label: 'Dark' },
  { id: 'reader', label: 'Reader', note: 'OpenDyslexic, large body, italics → bold' }
] as const;
---
<div class="relative" data-theme-switcher>
  <button
    type="button"
    id="theme-switcher-button"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label="Switch theme"
    class="flex items-center gap-2 px-2.5 py-1.5 rounded-full text-sm text-ink-muted hover:text-ink hover:bg-accent-primary-soft border border-rule transition-colors"
  >
    <span
      data-theme-dot
      class="w-3 h-3 rounded-full border border-rule shrink-0"
      style="background:#888"
      aria-hidden="true"
    ></span>
    <span class="hidden sm:inline" data-theme-label>Light</span>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div
    id="theme-switcher-menu"
    role="menu"
    aria-labelledby="theme-switcher-button"
    class="hidden absolute right-0 mt-2 w-64 max-h-[28rem] overflow-y-auto origin-top-right bg-bg-elev border border-rule rounded-lg shadow-lg z-30 p-1"
  >
    {THEMES.map((t) => (
      <button
        type="button"
        role="menuitemradio"
        data-theme-option={t.id}
        title={t.note ?? t.label}
        class="w-full flex items-start gap-3 px-3 py-2 rounded-md text-sm text-ink hover:bg-accent-primary-soft cursor-pointer transition-colors"
      >
        <span
          data-theme-swatch={t.id}
          class="w-4 h-4 mt-0.5 rounded-full border border-rule shrink-0"
          aria-hidden="true"
        ></span>
        <span class="flex-1 text-left">
          <span class="block">{t.label}</span>
          {t.note && <span class="block text-[10px] leading-tight text-ink-muted mt-0.5">{t.note}</span>}
        </span>
        <svg
          data-theme-check={t.id}
          class="hidden w-3.5 h-3.5 mt-0.5 text-accent-primary"
          viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        >
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </button>
    ))}
  </div>
</div>

<script is:inline define:vars={{ THEMES }}>
  (() => {
    const root = document.documentElement;
    const wrap = document.querySelector('[data-theme-switcher]');
    const btn = document.getElementById('theme-switcher-button');
    const menu = document.getElementById('theme-switcher-menu');
    if (!wrap || !btn || !menu) return;

    const themeById = Object.fromEntries(THEMES.map((t) => [t.id, t]));
    const valid = new Set(THEMES.map((t) => t.id));

    /* Legacy theme names are migrated by BaseLayout's no-FOUC script
       before this runs, so localStorage only ever holds a valid id here. */

    /* Probe `--color-primary` for each theme by briefly setting data-theme on
       an off-screen <div>. Runs once at mount; results cached into a map. */
    const probe = document.createElement('div');
    probe.style.cssText = 'position:absolute;left:-9999px;width:0;height:0;';
    document.body.appendChild(probe);
    const swatches = {};
    for (const t of THEMES) {
      probe.dataset.theme = t.id;
      const v = getComputedStyle(probe).getPropertyValue('--color-primary').trim();
      swatches[t.id] = v || '#888';
    }
    probe.remove();

    /* Paint every swatch dot in the menu now that we have the values. */
    document.querySelectorAll('[data-theme-swatch]').forEach((el) => {
      const id = el.dataset.themeSwatch;
      if (swatches[id]) el.style.background = swatches[id];
    });

    const current = () => {
      const t = root.dataset.theme || 'light';
      return valid.has(t) ? t : 'light';
    };

    const apply = (id) => {
      if (!valid.has(id)) return;
      root.dataset.theme = id;
      localStorage.setItem('theme', id);
      paintButton(id);
      paintMenu(id);
    };

    const paintButton = (id) => {
      const t = themeById[id];
      const dot = wrap.querySelector('[data-theme-dot]');
      const label = wrap.querySelector('[data-theme-label]');
      if (dot && swatches[id]) dot.style.background = swatches[id];
      if (label) label.textContent = t.label;
    };

    const paintMenu = (id) => {
      menu.querySelectorAll('[data-theme-check]').forEach((el) => {
        el.classList.toggle('hidden', el.dataset.themeCheck !== id);
      });
    };

    const open = () => {
      menu.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
      /* Scroll the active option into view inside the menu. */
      const active = menu.querySelector(`[data-theme-option="${current()}"]`);
      if (active) active.scrollIntoView({ block: 'nearest' });
    };
    const close = () => {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    };

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.contains('hidden') ? open() : close();
    });

    menu.querySelectorAll('[data-theme-option]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        apply(el.dataset.themeOption);
        close();
      });
    });

    document.addEventListener('click', (e) => {
      if (!wrap.contains(e.target)) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });

    paintButton(current());
    paintMenu(current());
  })();
</script>
