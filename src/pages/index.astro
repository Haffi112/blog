---
import BaseLayout from '~/components/BaseLayout.astro';
import JsonLdPerson from '~/components/JsonLdPerson.astro';
import Hero from '~/components/Hero.astro';
import NewsItem from '~/components/NewsItem.astro';
import PubDisclosure from '~/components/PubDisclosure.astro';
import SectionHeading from '~/components/SectionHeading.astro';
import { getCollection } from 'astro:content';
import pubsData from '~/data/publications.json';
import type { Publication } from '~/data/publications.schema';

/* Blog posts appear in the news feed alongside curated news entries, so new
   writing is visible from the front page. URL construction mirrors the
   [year]/[month]/[day]/[slug] route. */
const postItems = (await getCollection('blog', ({ data }) => !data.draft)).map(
  (post) => {
    const d = post.data.date;
    const year = String(d.getUTCFullYear());
    const month = String(d.getUTCMonth() + 1).padStart(2, '0');
    const day = String(d.getUTCDate()).padStart(2, '0');
    const slug = post.slug.replace(/^\d{4}-\d{2}-\d{2}-/, '');
    return {
      date: d,
      text: `New post: ${post.data.title}`,
      link: `/${year}/${month}/${day}/${slug}/`
    };
  }
);

const news = [
  ...(await getCollection('news')).map((n) => ({ ...n.data, id: n.id })),
  ...postItems
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 5);

const pubs = pubsData as unknown as Publication[];
const selected = pubs.filter((p) => p.selected).slice(0, 3);
---
<BaseLayout
  title="Home"
  description="Hafsteinn Einarsson — Associate Professor at the University of Iceland and Principal Scientist at Amgen deCODE."
>
  <JsonLdPerson slot="head" />
  <Hero />

  <!-- Two panels divided by a hairline. The rule is the 1px grid gap
       showing the container background through — that way it runs the full
       height of the taller column and collapses into a horizontal divider
       when the grid stacks, with no extra elements. -->
  <div
    class="max-w-page mx-auto grid gap-px bg-rule lg:grid-cols-2"
    data-reveal
  >
    <section class="bg-bg px-6 py-10 md:px-10 md:py-12">
      <SectionHeading number="01" title="News" rule={false} />
      <ul class="mt-6 list-none">
        {news.map((n, i) => (
          <NewsItem
            date={n.date}
            text={n.text}
            link={n.link}
            newest={i === 0}
          />
        ))}
      </ul>
    </section>

    <section class="bg-bg px-6 py-10 md:px-10 md:py-12">
      <SectionHeading
        number="02"
        title="Selected publications"
        href="/publications/"
        linkLabel="All"
        rule={false}
      />
      <div class="mt-6">
        {selected.map((p) => <PubDisclosure pub={p} />)}
      </div>
    </section>
  </div>
</BaseLayout>
