---
import { Picture } from 'astro:assets';
import PercolationField from './PercolationField.astro';
import hafsteinnPhoto from '~/assets/hafsteinn.png';
---
<section class="relative overflow-hidden border-b border-rule">
  <!-- Live percolation field, its own readability wash, and the controls
       that go with it. Everything below stacks above it. -->
  <PercolationField />

  <!-- pointer-events-none lets clicks fall through the type to the canvas
       so the whole hero is ignitable; the CTAs opt back in. -->
  <!-- Tighter vertical padding on mobile: with the portrait sitting inside
       the text flow the hero is taller there, and this keeps the CTAs
       inside the first screen on a typical phone. -->
  <div class="relative pointer-events-none max-w-page mx-auto px-6 pt-12 pb-12 md:pt-24 md:pb-20">
    <!-- Every block — including the portrait — is a direct grid child, so
         the same elements can be re-mapped per breakpoint by grid-template-
         areas alone (see the <style> block). That is what lets the portrait
         sit beside the text on desktop and *inside* the text flow, between
         the affiliation and the bio, on mobile — with no duplicated markup
         and no change to DOM order.

         Each block carries its own frosted plate rather than sharing one
         card, so the cascade stays visible between the lines. -->
    <div class="hero-grid grid">
      <span class="plate [grid-area:eyebrow] px-3 py-1.5 eyebrow">Machine learning research</span>

      <!-- Steeper fluid clamp below md: the name is the one element that
           cannot wrap, so it sets the floor for the text track once the
           portrait sits beside it. It relaxes into the full display scale
           at md, where the portrait moves alongside the whole block. -->
      <h1 class="plate [grid-area:name] px-2.5 md:px-4 py-2.5 text-[clamp(2rem,9vw,3.25rem)] leading-[0.98] tracking-[-0.022em] md:text-display font-light text-ink">
        Hafsteinn<br />Einarsson
      </h1>

      <p class="plate [grid-area:affil] px-3.5 py-2 font-prose italic font-light text-ink-muted text-[1.0625rem] md:text-[1.1875rem] leading-[1.5]">
        Associate Professor, University of Iceland<br />
        Principal Scientist, Amgen deCODE
      </p>

      <!-- Portrait: square-cornered, desaturated to sit inside the paper
           palette, on a hatched backing that shows through while the image
           decodes. -->
      <!-- Width lives in the scoped CSS, not in a utility — see the note on
           grid-template-columns below. -->
      <div class="hero-portrait [grid-area:portrait] relative aspect-4/5">
        <Picture
          src={hafsteinnPhoto}
          alt="Hafsteinn Einarsson"
          widths={[264, 528]}
          formats={['avif', 'webp']}
          fallbackFormat="png"
          class="absolute inset-0 w-full h-full object-cover grayscale contrast-[1.06]"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <p class="plate [grid-area:bio] px-4 py-3 prose-body max-w-[46ch] text-[1.03125rem] md:text-[1.15rem]">
        I lead a research group working on natural language processing for
        Icelandic and Faroese, with active projects in computer vision for
        the natural sciences, clinical AI, and human genetics.
      </p>

      <div class="[grid-area:cta] pointer-events-auto mt-1.5 flex flex-wrap gap-2.5">
        <a href="/research/" class="btn-editorial btn-editorial--solid">Research →</a>
        <a href="/publications/" class="btn-editorial plate">Publications →</a>
        <a href="/cv.pdf" class="btn-editorial plate">Download CV ↓</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Gaps and the portrait's width both live here rather than in utility
     classes: Tailwind's gap-x utility was winning the cascade over the
     scoped column-gap, and having two sources fight over the same property
     across three breakpoints is a bug waiting to happen. */
  .hero-grid {
    row-gap: 0.875rem;
    justify-items: start;
  }

  /* Narrowest: the portrait sits above the name and steps down in size, so
     the name gets the full width to itself. Below the eyebrow, not above
     it — the eyebrow is the page's kicker and stays on top. */
  .hero-grid {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'eyebrow'
      'portrait'
      'name'
      'affil'
      'bio'
      'cta';
  }
  .hero-grid > .hero-portrait {
    width: clamp(5rem, 20vw, 7.5rem);
    margin-bottom: 0.25rem;
  }

  /* From here up the portrait sits to the right of the name. Its span
     starts at the name row, so "top of portrait = top of name" is the grid
     geometry itself rather than a hand-tuned offset.

     minmax(0, max-content) keeps the text track safe: it wants to be as
     wide as its widest item — the affiliation line, not the name — and the
     0 minimum lets it shrink below that, so the affiliation wraps instead
     of forcing an overflow. The name can't wrap, so it sets the real floor;
     hence its steeper clamp below md. justify-content:start keeps both
     tracks hugging their content, so the portrait can never drift away from
     the text as the viewport grows.

     The portrait track is sized here rather than on the portrait itself.
     With an `auto` track the full-width rows below (the bio especially, at
     46ch) distribute their max-content contribution across both columns and
     inflate the portrait track — measured 69px/187px at 320px, which
     crushed the name's track and pushed the h1 out from under itself and
     beneath the portrait. A definite track cannot be inflated. */
  @media (min-width: 32rem) {
    .hero-grid {
      grid-template-columns: minmax(0, max-content) clamp(7rem, 26vw, 11rem);
      column-gap: clamp(1.25rem, 3vw, 2.5rem);
      justify-content: start;
      grid-template-areas:
        'eyebrow  .'
        'name     portrait'
        'affil    portrait'
        'bio      bio'
        'cta      cta';
    }
    .hero-grid > .hero-portrait {
      width: 100%;
      margin-bottom: 0;
      align-self: start;
    }
  }

  /* Desktop: the bio and buttons move alongside the portrait too. */
  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: minmax(0, max-content) 11rem;
      column-gap: clamp(1.75rem, 3.5vw, 3rem);
      grid-template-areas:
        'eyebrow  .'
        'name     portrait'
        'affil    portrait'
        'bio      portrait'
        'cta      portrait';
    }
  }

  @media (min-width: 1024px) {
    .hero-grid { grid-template-columns: minmax(0, max-content) 14rem; }
  }

  @media (min-width: 1280px) {
    .hero-grid { grid-template-columns: minmax(0, max-content) 16.5rem; }
  }

  /* 45° hatch in the paper's own two tones — the same trick the design
     uses to keep the portrait from floating on the canvas. */
  .hero-portrait {
    background: repeating-linear-gradient(
      45deg,
      var(--color-base-300) 0 6px,
      var(--color-bg-elev) 6px 12px
    );
    box-shadow: 0 18px 44px color-mix(in oklch, var(--color-ink) 18%, transparent);
  }
</style>
