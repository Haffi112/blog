---
import { Image, getImage } from 'astro:assets';
import type { NewsImage, NewsKind } from '~/lib/news';
import { useTranslations, type Lang } from '~/i18n/utils';

interface Props {
  date: Date;
  text: string;
  link?: string;
  newest?: boolean;
  /** What the item is about: a small mono label above the text. */
  kind?: NewsKind;
  lang?: Lang;
  /** `lang` for `text` when it differs from the page (an English post title on /is/). */
  textLang?: string;
  /** `hreflang` for the link, when it opens a page in another language. */
  hreflang?: string;
  /** 'year' when only the year is known: show "2021", not "2021-01". */
  precision?: 'year' | 'month';
  /** Thumbnails under the text, in the column beside the date. */
  images?: NewsImage[];
}

const { date, text, link, newest = false, kind, lang = 'en', textLang, hreflang, precision = 'month', images = [] } = Astro.props;
const t = useTranslations(lang);
/* Papers carry the house rust; everything else stays in muted ink, so the
   feed does not turn into a colour chart. */
const kindTone = kind === 'paper' || kind === 'post' ? 'text-accent-primary' : 'text-ink-faint';
const iso = date.toISOString().slice(0, 10);
const formatted = precision === 'year' ? iso.slice(0, 4) : iso.slice(0, 7); // YYYY or YYYY-MM
/* Each thumbnail opens a larger copy, so the full-size original never ships. */
const full = await Promise.all(images.map((img) => getImage({ src: img.src, width: 1600 })));
---
<li class="grid grid-cols-[4.5rem_1fr] gap-x-3 sm:gap-x-4 gap-y-2 py-[0.9375rem] border-t border-rule-soft last:border-b last:border-b-rule-soft">
  <time datetime={precision === 'year' ? iso.slice(0, 4) : iso} class="meta pt-1 flex items-center gap-1.5">
    {newest && (
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent-energy" aria-hidden="true" />
    )}
    {formatted}
  </time>
  <p class="font-prose text-[1.0625rem] leading-[1.45] text-ink">
    {kind && (
      <span class:list={['block mb-1 font-mono text-[0.6875rem] uppercase tracking-[0.1em] leading-none', kindTone]}>{t.news.kinds[kind]}</span>
    )}
    {/* The whole sentence is the link, but it reads as prose: no
        underline, a mono arrow marks it, and it turns rust on hover. */}
    {link ? (
      <a href={link} hreflang={hreflang} class="link-plain group">{textLang ? <span lang={textLang}>{text}</span> : text}<span class="meta ml-1.5 whitespace-nowrap group-hover:text-accent-primary transition-colors" aria-hidden="true">→</span></a>
    ) : (
      <Fragment>{textLang ? <span lang={textLang}>{text}</span> : text}</Fragment>
    )}
  </p>
  {images.length > 0 && (
    <ul class="col-start-2 mt-1 grid grid-cols-2 gap-2 max-w-[17rem] list-none">
      {images.map((img, i) => (
        <li>
          <a href={full[i].src} class="link-plain group block">
            <Image
              src={img.src}
              alt={img.alt}
              lang={img.altLang}
              width={264}
              height={198}
              fit="cover"
              class="w-full aspect-4/3 object-cover border border-rule grayscale-[35%] group-hover:grayscale-0 transition-[filter] duration-300"
              loading="lazy"
            />
          </a>
        </li>
      ))}
    </ul>
  )}
</li>
