---
import { fallbackLang, pick, useTranslations, type Lang } from '~/i18n/utils';

interface Props {
  name: string;
  name_is?: string;
  summary: string;
  summary_is?: string;
  links?: {
    repo?: string;
    huggingface?: string;
    site?: string;
    dataset?: string;
  };
  tags?: string[];
  status: 'active' | 'maintenance' | 'archived';
  lang?: Lang;
}
const { name, name_is, summary, summary_is, links = {}, status, lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const linkOrder: Array<keyof NonNullable<Props['links']>> = ['huggingface', 'repo', 'dataset', 'site'];
const visibleLinks = linkOrder.filter((key) => links[key]);

const statusTone: Record<Props['status'], string> = {
  active: 'text-accent-energy',
  maintenance: 'text-ink-muted',
  archived: 'text-ink-muted'
};
---
<article class="py-5 border-t border-rule first:border-t-0">
  <div class="flex items-baseline gap-3">
    <h3 class="text-[1.1875rem] font-medium text-ink">{pick(lang, name, name_is)}</h3>
    <span class:list={['text-xs uppercase tracking-wide', statusTone[status]]}>{t.project.status[status]}</span>
  </div>
  <p class="mt-2 prose-body max-w-prose text-ink" lang={fallbackLang(lang, summary_is)}>{pick(lang, summary, summary_is)}</p>
  {visibleLinks.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-3 text-sm">
      {visibleLinks.map((key) => (
        <li><a href={links[key]}>{t.project.links[key]} →</a></li>
      ))}
    </ul>
  )}
</article>
