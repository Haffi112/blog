---
import type { Theme } from '~/data/publications.schema';
import { localizePath, useTranslations, type Lang } from '~/i18n/utils';

interface Props {
  theme: Theme;
  title: string;
  body: string;
  anchor: string; // matching id on the publications page, e.g. "nlp-is"
  lang?: Lang;
}
const { title, body, anchor, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---
<article class="bg-bg-elev border border-rule rounded-card p-6">
  <h3 class="text-[1.3125rem] font-medium text-ink">{title}</h3>
  <p class="mt-2 prose-body max-w-prose">{body}</p>
  <p class="mt-3 text-sm">
    <a href={localizePath(`/publications/#${anchor}`, lang)}>{t.research.relatedPubs}</a>
  </p>
</article>
