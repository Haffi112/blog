---
/**
 * GraphField — an animated "knowledge graph" particle field running a
 * gentle bootstrap-percolation-style process (a nod to the 2016 blog
 * posts): nodes fire, messages travel along edges as small particles,
 * arriving messages activate rested nodes, and each activation is
 * followed by a refractory period (drawn as a refilling recovery arc)
 * so activity propagates in elegant waves instead of runaway seizures.
 *
 * Triggers: moving the cursor over the field delivers messages from the
 * nodes it touches; an ambient timer fires a random node every few
 * seconds so the field is alive without interaction.
 *
 * Performance / accessibility contract:
 *  - no dependencies; the whole thing is this inline script
 *  - devicePixelRatio-aware, capped at 2
 *  - animation pauses when the canvas leaves the viewport or the tab hides
 *  - prefers-reduced-motion gets a single static frame, no animation
 *  - colors come from the theme's CSS custom properties and re-resolve
 *    when data-theme changes, so the field matches light/dark/reader
 *  - without JavaScript the canvas stays blank and invisible; content is
 *    unaffected
 */
---
<canvas data-graph-field class="w-full h-full block" aria-hidden="true"></canvas>

<script is:inline>
  (() => {
    const canvas = document.querySelector('[data-graph-field]');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    /* Resolve theme colors by probing computed `color` (this forces the
       browser to collapse oklch()/color-mix() tokens into a plain rgb()
       string that every canvas implementation accepts). */
    let inkColor = 'rgb(120 110 130)';
    let nodeColor = 'rgb(91 58 120)';
    let energyColor = 'rgb(190 90 60)';
    const resolveColors = () => {
      const probe = document.createElement('span');
      probe.style.display = 'none';
      document.body.appendChild(probe);
      const grab = (token) => {
        probe.style.color = `var(${token})`;
        return getComputedStyle(probe).color;
      };
      inkColor = grab('--color-ink-muted') || inkColor;
      nodeColor = grab('--color-accent-primary') || nodeColor;
      energyColor = grab('--color-accent-energy') || energyColor;
      probe.remove();
    };
    resolveColors();
    /* Re-resolve on theme switch; repaint immediately if the loop is
       parked (reduced motion / off-screen). */
    new MutationObserver(() => {
      resolveColors();
      if (!raf) draw(lastTs);
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme']
    });

    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    const LINK_DIST = 150;      // px — edge visibility + message reach
    const DRIFT = 0.24;         // px/frame @60fps — baseline node drift
    const MSG_SPEED = 0.085;    // px/ms — message particle travel speed
    const ACTIVE_MS = 600;      // how long a node glows when it fires
    const K = 2;                // bootstrap percolation threshold: messages
                                // needed before a node activates
    const POT_MS = 2600;        // how long collected potential lingers
    const FANOUT = 4;           // messages sent per activation
    const MAX_GEN = 6;          // cascade depth: spikes this many hops
                                // from the seed stop transmitting, so a
                                // wave always fades instead of reverbing
                                // through the graph forever
    const MAX_MSGS = 260;       // global particle cap
    let w = 0, h = 0, nodes = [], msgs = [];

    const rand = (a, b) => a + Math.random() * (b - a);

    const seed = () => {
      const count = Math.min(280, Math.max(70, Math.round((w * h) / 4500)));
      nodes = Array.from({ length: count }, () => {
        const x = rand(0, w), y = rand(0, h);
        return {
        x, y,
        hx: x,                  // home anchor — a weak spring pulls the
        hy: y,                  // node back so the field never clumps
        vx: rand(-DRIFT, DRIFT),
        vy: rand(-DRIFT, DRIFT),
        r: rand(1.1, 2.4),
        state: 0,               // 0 rest · 1 active · 2 refractory
        stateT: 0,
        pot: 0,                 // messages collected toward the K threshold
        potT: 0,
        refrMs: rand(2600, 4200)
        };
      });
      msgs = [];
    };

    const resize = () => {
      const rect = canvas.parentElement.getBoundingClientRect();
      if (rect.width === w && rect.height === h && nodes.length) return;
      w = rect.width;
      h = rect.height;
      canvas.width = Math.round(w * DPR);
      canvas.height = Math.round(h * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      seed();
    };

    /* Fire a node: glow, then send messages to its nearest RESTED
       neighbours (excluding whoever delivered the triggering message).
       Targeting rested nodes only is what keeps a wave travelling: the
       nearest neighbours of a fresh spike are mostly the refractory
       nodes behind the wavefront, where messages would be wasted. */
    const fire = (n, ts, from, gen = 0) => {
      n.state = 1;
      n.stateT = ts;
      n.pot = 0;
      if (gen >= MAX_GEN) return; // wave has run its course — glow only
      const targets = nodes
        .filter((m) => m !== n && m !== from && m.state === 0)
        .map((m) => ({ m, d2: (m.x - n.x) ** 2 + (m.y - n.y) ** 2 }))
        .filter((e) => e.d2 < LINK_DIST * LINK_DIST)
        .sort((a, b) => a.d2 - b.d2)
        .slice(0, FANOUT);
      for (const { m, d2 } of targets) {
        if (msgs.length >= MAX_MSGS) break;
        msgs.push({ a: n, b: m, start: ts, dur: Math.sqrt(d2) / MSG_SPEED, gen: gen + 1 });
      }
    };

    /* Pointer interaction. Hover (fine pointers) attracts and highlights
       nearby vertices; press fires everything in a region around the
       cursor, and holding grows the region — refractory periods keep the
       resulting cascade from running away. Taps on touch devices get the
       same press behaviour. */
    const pointer = { x: -1e4, y: -1e4, down: false, downT: 0 };
    /* Listen on the enclosing section, not the canvas wrapper: the hero
       content stacks above the canvas layer, so events over text would
       never reach the wrapper — but they all bubble through the section. */
    const host = canvas.closest('section') || canvas.parentElement;
    const track = (e) => {
      const rect = canvas.getBoundingClientRect();
      pointer.x = e.clientX - rect.left;
      pointer.y = e.clientY - rect.top;
    };
    if (window.matchMedia('(pointer: fine)').matches) {
      host.addEventListener('pointermove', track);
    }
    host.addEventListener('pointerdown', (e) => {
      track(e);
      pointer.down = true;
      pointer.downT = performance.now();
    });
    const release = () => { pointer.down = false; };
    host.addEventListener('pointerup', release);
    host.addEventListener('pointercancel', release);
    host.addEventListener('pointerleave', () => {
      release();
      pointer.x = -1e4;
      pointer.y = -1e4;
    });

    /* Press region: starts at 50px and grows to 280px while held. */
    const pressRadius = (ts) =>
      pointer.down ? Math.min(280, 50 + (ts - pointer.downT) * 0.14) : 0;

    const HOVER_R = 30;

    let nextAmbient = 0;
    const step = (ts, dt) => {
      const k = dt / 16.7; // normalise drift to a 60fps baseline
      const pr = pressRadius(ts);
      for (const n of nodes) {
        /* Extremely subtle cursor attraction — a lean, not a pull. The
           home spring below undoes any accumulated clustering. */
        const dx = pointer.x - n.x, dy = pointer.y - n.y;
        const d2 = dx * dx + dy * dy;
        if (d2 < 140 * 140 && d2 > 1) {
          const f = 0.0008 / Math.sqrt(d2);
          n.vx += dx * f * k;
          n.vy += dy * f * k;
        }
        /* Weak spring toward the home anchor + a whisper of noise so the
           field keeps drifting forever without ever clumping. */
        n.vx += (n.hx - n.x) * 0.00035 * k + rand(-0.02, 0.02) * k;
        n.vy += (n.hy - n.y) * 0.00035 * k + rand(-0.02, 0.02) * k;
        /* Pressing delivers messages: rested nodes inside the (growing)
           press region fire once, then their refractory period holds
           them back. */
        if (pr && n.state === 0 && d2 < pr * pr) fire(n, ts);

        /* State clock: active → refractory → rest; collected potential
           leaks away if the second message never arrives. */
        if (n.state === 1 && ts - n.stateT > ACTIVE_MS) {
          n.state = 2;
          n.stateT = ts;
        } else if (n.state === 2 && ts - n.stateT > n.refrMs) {
          n.state = 0;
        }
        if (n.pot && ts - n.potT > POT_MS) n.pot = 0;

        /* Cap velocity so cursor energy dissipates. */
        n.vx = Math.max(-0.5, Math.min(0.5, n.vx * 0.995));
        n.vy = Math.max(-0.5, Math.min(0.5, n.vy * 0.995));
        n.x += n.vx * k;
        n.y += n.vy * k;
      }

      /* Message delivery: bootstrap percolation with threshold K — an
         arriving message raises the target's potential; the node only
         fires once K messages have accumulated.

         Arrivals are collected first and delivered AFTER the filter
         reassigns `msgs`. Firing inside the filter callback would push
         the new generation of messages onto the array being replaced,
         silently discarding them — cascades would spike but never
         visibly transmit onward. */
      const arrivals = [];
      msgs = msgs.filter((p) => {
        const prog = (ts - p.start) / p.dur;
        if (prog >= 1) {
          arrivals.push(p);
          return false;
        }
        /* Drop messages whose endpoints drifted apart (edge vanished). */
        const dx = p.a.x - p.b.x, dy = p.a.y - p.b.y;
        return dx * dx + dy * dy < (LINK_DIST * 1.35) ** 2;
      });
      for (const p of arrivals) {
        if (p.b.state !== 0) continue;
        p.b.pot += 1;
        p.b.potT = ts;
        if (p.b.pot >= K) fire(p.b, ts, p.a, p.gen);
      }

      /* Ambient activity: fire a random rested node plus its nearest
         rested neighbour every few seconds. Two adjacent seeds give
         shared neighbours a chance to reach the K=2 threshold, so
         ambient waves can percolate a little before dying out. */
      if (ts >= nextAmbient) {
        const rested = nodes.filter((n) => n.state === 0);
        if (rested.length) {
          /* Ambient seeds start mid-generation: unattended ripples run
             ~3 hops and fade, while pointer-triggered cascades get the
             full MAX_GEN depth. */
          const seed = rested[(Math.random() * rested.length) | 0];
          fire(seed, ts, undefined, 3);
          let best = null, bestD2 = LINK_DIST * LINK_DIST;
          for (const m of rested) {
            if (m === seed) continue;
            const d2 = (m.x - seed.x) ** 2 + (m.y - seed.y) ** 2;
            if (d2 < bestD2) { best = m; bestD2 = d2; }
          }
          if (best) fire(best, ts, undefined, 3);
        }
        nextAmbient = ts + rand(2200, 4800);
      }
    };

    const TAU = Math.PI * 2;
    const draw = (ts) => {
      ctx.clearRect(0, 0, w, h);
      /* Edges first, then nodes, messages on top. Hairline edges at low
         alpha so the dense mesh reads as texture, not wireframe. Alpha is
         quantised into a few buckets so the whole mesh strokes in ~5
         draw calls instead of thousands. */
      const BUCKETS = 5;
      const paths = Array.from({ length: BUCKETS }, () => new Path2D());
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 > LINK_DIST * LINK_DIST) continue;
          const t = 1 - Math.sqrt(d2) / LINK_DIST;
          const bi = Math.min(BUCKETS - 1, (t * BUCKETS) | 0);
          paths[bi].moveTo(a.x, a.y);
          paths[bi].lineTo(b.x, b.y);
        }
      }
      ctx.strokeStyle = inkColor;
      ctx.lineWidth = 0.75;
      for (let bi = 0; bi < BUCKETS; bi++) {
        ctx.globalAlpha = 0.16 * ((bi + 0.5) / BUCKETS);
        ctx.stroke(paths[bi]);
      }
      ctx.lineWidth = 1;
      for (const n of nodes) {
        if (n.state === 1) {
          /* Active: brighter, larger, with an expanding pulse ring. */
          const pa = Math.min(1, (ts - n.stateT) / ACTIVE_MS);
          ctx.globalAlpha = 0.95;
          ctx.fillStyle = energyColor;
          ctx.beginPath();
          ctx.arc(n.x, n.y, n.r * 1.5, 0, TAU);
          ctx.fill();
          ctx.globalAlpha = 0.5 * (1 - pa);
          ctx.strokeStyle = energyColor;
          ctx.beginPath();
          ctx.arc(n.x, n.y, n.r + pa * 16, 0, TAU);
          ctx.stroke();
        } else if (n.state === 2) {
          /* Refractory: dimmed dot + recovery arc refilling clockwise. */
          const pr = Math.min(1, (ts - n.stateT) / n.refrMs);
          ctx.globalAlpha = 0.25;
          ctx.fillStyle = nodeColor;
          ctx.beginPath();
          ctx.arc(n.x, n.y, n.r, 0, TAU);
          ctx.fill();
          ctx.globalAlpha = 0.55;
          ctx.strokeStyle = nodeColor;
          ctx.beginPath();
          ctx.arc(n.x, n.y, n.r + 2.5, -Math.PI / 2, -Math.PI / 2 + TAU * pr);
          ctx.stroke();
        } else {
          /* Rest: hovering nearby swells and brightens the vertex with a
             soft halo, proportional to cursor proximity. */
          const dx = pointer.x - n.x, dy = pointer.y - n.y;
          const d = Math.sqrt(dx * dx + dy * dy);
          const f = d < HOVER_R ? 1 - d / HOVER_R : 0;
          if (f > 0) {
            ctx.globalAlpha = 0.25 * f;
            ctx.fillStyle = nodeColor;
            ctx.beginPath();
            ctx.arc(n.x, n.y, n.r + 7 * f, 0, TAU);
            ctx.fill();
          }
          ctx.globalAlpha = 0.65 + 0.35 * f;
          ctx.fillStyle = nodeColor;
          ctx.beginPath();
          ctx.arc(n.x, n.y, n.r * (1 + 0.9 * f), 0, TAU);
          ctx.fill();
          /* Primed: a partial charge arc shows collected potential
             (pot/K of the way to firing). */
          if (n.pot > 0) {
            ctx.globalAlpha = 0.6;
            ctx.strokeStyle = energyColor;
            ctx.beginPath();
            ctx.arc(n.x, n.y, n.r + 2.5, -Math.PI / 2, -Math.PI / 2 + TAU * (n.pot / K));
            ctx.stroke();
          }
        }
      }
      /* Press region: a soft expanding boundary around the cursor. */
      const prNow = pressRadius(ts);
      if (prNow) {
        ctx.strokeStyle = energyColor;
        ctx.lineWidth = 1.5;
        ctx.globalAlpha = 0.45;
        ctx.beginPath();
        ctx.arc(pointer.x, pointer.y, prNow, 0, TAU);
        ctx.stroke();
        ctx.globalAlpha = 0.04;
        ctx.fillStyle = energyColor;
        ctx.beginPath();
        ctx.arc(pointer.x, pointer.y, prNow, 0, TAU);
        ctx.fill();
      }
      /* Messages: small bright particles with a soft halo. */
      ctx.fillStyle = energyColor;
      for (const p of msgs) {
        const prog = Math.min(1, (ts - p.start) / p.dur);
        const x = p.a.x + (p.b.x - p.a.x) * prog;
        const y = p.a.y + (p.b.y - p.a.y) * prog;
        ctx.globalAlpha = 0.16;
        ctx.beginPath();
        ctx.arc(x, y, 5, 0, TAU);
        ctx.fill();
        ctx.globalAlpha = 0.9;
        ctx.beginPath();
        ctx.arc(x, y, 1.7, 0, TAU);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    let raf = 0;
    let visible = false;
    let lastTs = 0;
    const loop = (ts) => {
      const dt = Math.min(50, lastTs ? ts - lastTs : 16.7);
      lastTs = ts;
      step(ts, dt);
      draw(ts);
      raf = requestAnimationFrame(loop);
    };
    const start = () => {
      if (raf || reduced.matches || !visible || document.hidden) return;
      lastTs = 0;
      raf = requestAnimationFrame(loop);
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };

    const io = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      visible ? start() : stop();
    });
    io.observe(canvas);

    document.addEventListener('visibilitychange', () => {
      document.hidden ? stop() : start();
    });

    reduced.addEventListener?.('change', () => {
      if (reduced.matches) { stop(); draw(lastTs); } else start();
    });

    /* ResizeObserver (rather than an eager resize() call): this inline
       script executes mid-parse, before the hero has its final height, so
       measuring now would yield a zero-sized canvas. The observer fires
       once layout settles and again whenever the hero changes size. */
    let resizeTimer = 0;
    new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        resize();
        /* Repaint if the loop is parked (reduced motion / off-screen). */
        if (!raf) draw(lastTs);
      }, 100);
    }).observe(canvas.parentElement);
  })();
</script>
