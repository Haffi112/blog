---
import { Picture } from 'astro:assets';
import PercolationField from './PercolationField.astro';
import hafsteinnPhoto from '~/assets/hafsteinn.png';
---
<section class="relative overflow-hidden border-b border-rule">
  <!-- Live percolation field, its own readability wash, and the controls
       that go with it. Everything below stacks above it. -->
  <PercolationField />

  <!-- pointer-events-none lets clicks fall through the type to the canvas
       so the whole hero is ignitable; the CTAs opt back in. -->
  <div class="relative pointer-events-none max-w-page mx-auto px-6 pt-16 pb-16 md:pt-24 md:pb-20">
    <!-- Text takes the free column, the portrait a content-sized one pinned
         to the container's right edge. The design file pins it to the
         *start* of an equal second column, but that was a 1180px card with
         its own border; full-bleed here, the same rule strands the portrait
         mid-canvas with nothing to close the gap on its right.

         On mobile the order is flipped visually so the portrait leads
         instead of dangling under the CTAs. DOM order is unchanged, so the
         <h1> still comes first for assistive tech; nothing in the portrait
         is focusable, so tab order is unaffected. -->
    <div class="grid gap-10 md:gap-[clamp(1.75rem,4vw,3.5rem)] md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
      <!-- Each block carries its own frosted plate rather than sharing one
           card, so the cascade stays visible between the lines. -->
      <div class="order-2 md:order-1 flex flex-col items-start gap-3.5 max-w-2xl">
        <span class="plate inline-block px-3 py-1.5 eyebrow">Machine learning research</span>

        <h1 class="plate inline-block px-4 py-2.5 text-display font-light text-ink">
          Hafsteinn<br />Einarsson
        </h1>

        <p class="plate inline-block px-3.5 py-2 font-prose italic font-light text-ink-muted text-[1.0625rem] md:text-[1.1875rem] leading-[1.5]">
          Associate Professor, University of Iceland<br />
          Principal Scientist, Amgen deCODE
        </p>

        <p class="plate inline-block px-4 py-3 prose-body max-w-[50ch] text-[1.03125rem] md:text-[1.15rem]">
          I lead a research group working on natural language processing for
          Icelandic and Faroese, with active projects in computer vision for
          the natural sciences, clinical AI, and human genetics.
        </p>

        <div class="pointer-events-auto mt-1.5 flex flex-wrap gap-2.5">
          <a href="/research/" class="btn-editorial btn-editorial--solid">Research →</a>
          <a href="/publications/" class="btn-editorial plate">Publications →</a>
          <a href="/cv.pdf" class="btn-editorial plate">Download CV ↓</a>
        </div>
      </div>

      <!-- Portrait: square-cornered, desaturated to sit inside the paper
           palette, on a hatched backing that shows through while the image
           decodes. -->
      <div
        class="hero-portrait order-1 md:order-2 relative w-[70%] max-w-52 md:w-52 md:max-w-none lg:w-64 xl:w-[18.25rem] justify-self-start md:justify-self-end aspect-4/5"
      >
        <Picture
          src={hafsteinnPhoto}
          alt="Hafsteinn Einarsson"
          widths={[292, 584]}
          formats={['avif', 'webp']}
          fallbackFormat="png"
          class="absolute inset-0 w-full h-full object-cover grayscale contrast-[1.06]"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* 45° hatch in the paper's own two tones — the same trick the design
     uses to keep the portrait from floating on the canvas. */
  .hero-portrait {
    background: repeating-linear-gradient(
      45deg,
      var(--color-base-300) 0 6px,
      var(--color-bg-elev) 6px 12px
    );
    box-shadow: 0 18px 44px color-mix(in oklch, var(--color-ink) 18%, transparent);
  }
</style>
