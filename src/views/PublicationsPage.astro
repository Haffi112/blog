---
import BaseLayout from '~/components/BaseLayout.astro';
import PageShell from '~/components/PageShell.astro';
import SectionHeading from '~/components/SectionHeading.astro';
import PubCard from '~/components/PubCard.astro';
import PubDisclosure from '~/components/PubDisclosure.astro';
import pubsData from '~/data/publications.json';
import type { Publication, Theme } from '~/data/publications.schema';
import { themes } from '~/data/themes';
import { formatDate, useTranslations, type Lang } from '~/i18n/utils';

/* Publications page body, shared by /publications/ and /is/publications/.
   Titles, authors, venues and summaries stay as published (English). */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const all = pubsData as unknown as Publication[];
const selected = all.filter((p) => p.selected);

const byTheme: Record<Theme, Publication[]> = {
  'nlp-is': [],
  'cv-nat': [],
  'clinical-ai': [],
  genetics: [],
  'comp-neuro': [],
  'discrete-math': []
};
for (const p of all) {
  if (p.theme) byTheme[p.theme].push(p);
}
// Within each theme entries are already sorted by year desc (parse-bib).

const sections = [
  ...(selected.length > 0 ? [{ id: 'selected', label: t.publications.selected }] : []),
  ...themes.filter((th) => byTheme[th.code].length > 0).map((th) => ({ id: th.code, label: th.tag[lang] }))
];

const lastBuild = new Date();
const updated =
  lang === 'en'
    ? lastBuild.toISOString().slice(0, 10)
    : formatDate(lastBuild, lang, { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title={t.publications.title} description={t.publications.description} lang={lang}>
  <PageShell title={t.publications.title} sections={sections} sectionsLabel={t.writing.sectionsLabel}>
    <Fragment slot="aside">
      <p class="mt-4 font-prose text-[0.9375rem] leading-[1.6] text-ink-muted">
        {t.publications.count(all.length)} · {t.publications.lastUpdated} {updated} ·
        <a href="https://orcid.org/0000-0001-5072-3678" class="underline underline-offset-2 decoration-1 hover:decoration-2">ORCID</a> ·
        <a href="https://scholar.google.com/citations?user=QH69Qk8AAAAJ&hl=en" class="underline underline-offset-2 decoration-1 hover:decoration-2">Google Scholar</a>
      </p>
      {t.publications.languageNote && (
        <p class="mt-2 meta">{t.publications.languageNote}</p>
      )}
      <details class="mt-4 font-prose text-[0.9375rem] leading-[1.55] text-ink-muted">
        <summary class="cursor-pointer">{t.publications.authorship}</summary>
        <p class="mt-2">{t.publications.authorshipBody}</p>
      </details>
    </Fragment>

    {/* The shortlist is a set of disclosures, as on the home page: titles
        scan, and a summary opens on click. */}
    {selected.length > 0 && (
      <section id="selected" class="mt-12 scroll-mt-20" data-reveal>
        <SectionHeading title={t.publications.selected} rule={false} />
        <div class="mt-5">
          {selected.map((p) => <PubDisclosure pub={p} lang={lang} />)}
        </div>
      </section>
    )}

    <section class="mt-16" data-reveal>
      <SectionHeading title={t.publications.all} />
      {themes.map((th) => (
        byTheme[th.code].length > 0 && (
          <section class="mt-10">
            <h3 id={th.code} class="text-[1.375rem] font-normal text-ink mb-2 scroll-mt-20">{th.heading[lang]}</h3>
            {/* A selected paper's full summary is in the shortlist above;
                here it is cut to three lines so the list stays even. */}
            {byTheme[th.code].map((p) => <PubCard pub={p} clamp={p.selected} lang={lang} />)}
          </section>
        )
      ))}
    </section>
  </PageShell>
</BaseLayout>
