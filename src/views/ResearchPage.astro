---
import BaseLayout from '~/components/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import SectionHeading from '~/components/SectionHeading.astro';
import ThemeCard from '~/components/ThemeCard.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import { themes } from '~/data/themes';
import { useTranslations, type Lang } from '~/i18n/utils';
import { getCollection } from 'astro:content';

/* Research page body, shared by /research/ and /is/research/. Media
   appearances and talks live on the Outreach page (WritingPage.astro). */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

/* Alphabetical by file id, which is how the list has always read. */
const projects = (await getCollection('projects'))
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((p) => p.data);
---
<BaseLayout title={t.research.title} description={t.research.description} lang={lang}>
  <section class="max-w-prose mx-auto px-6 pb-12">
    <PageHeader title={t.research.title} lede={t.research.lede} />

    <section id="themes" class="mt-12 scroll-mt-20" data-reveal>
      <SectionHeading title={t.research.themes} />
      <div class="mt-6 flex flex-col gap-4">
        {themes.map((th) => (
          <ThemeCard theme={th.code} title={th.title[lang]} body={th.body[lang]} anchor={th.code} lang={lang} />
        ))}
      </div>
    </section>

    <section id="projects" class="mt-16 scroll-mt-20" data-reveal>
      <SectionHeading title={t.research.projects} />
      <p class="mt-3 text-ink-muted text-sm">{t.research.projectsIntro}</p>
      <div class="mt-4">
        {projects.map((p) => <ProjectCard {...p} lang={lang} />)}
      </div>
    </section>
  </section>
</BaseLayout>
