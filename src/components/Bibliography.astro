---
import { citedRefs } from '~/lib/citations';
import { formatAuthor } from '~/lib/format-authors';

interface Props {
  keys: string[]; // bibtex ids cited in the page
}

const { keys } = Astro.props;
// Same order as the numbers <Cite> prints.
const refs = citedRefs(keys);
---
<ol class="mt-8 max-w-prose font-prose text-[0.9375rem] leading-[1.5] text-ink-muted space-y-2 list-decimal pl-6">
  {refs.map((r) => (
    <li id={`ref-${r.id}`} class="scroll-mt-20">
      {r.authors.map(formatAuthor).join('; ')}
      {' '}({r.year}).{' '}
      <span class="text-ink">{r.title}</span>.
      {r.venue && <span> {r.venue}.</span>}
    </li>
  ))}
</ol>
