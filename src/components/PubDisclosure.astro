---
import type { Publication } from '~/data/publications.schema';
import { formatAuthor, isYou } from '~/lib/format-authors';
import ThemeTag from './ThemeTag.astro';
import CiteButton from './CiteButton.astro';
import { fallbackLang, pick, useTranslations, type Lang } from '~/i18n/utils';

/**
 * Selected-publication row as a disclosure: theme tag, serif title and an
 * italic byline are always visible; the summary and the link rail unfold on
 * click. Used on the homepage, where the point is a scannable shortlist
 * rather than the full record shown by PubCard on /publications/.
 */
interface Props {
  pub: Publication;
  lang?: Lang;
}

const { pub, lang = 'en' } = Astro.props;

const t = useTranslations(lang);
const linkOrder: Array<keyof Publication['links']> = ['doi', 'arxiv', 'pdf', 'code', 'huggingface', 'dataset'];

const links = linkOrder
  .filter((key) => pub.links?.[key])
  .map((key) => ({ key, label: t.pub.links[key] }));
/* The Icelandic summary on /is/ pages; the English one, marked as such,
   if a publication has none yet. */
const summary = pick(lang, pub.summary, pub.summary_is);
const summaryLang = pub.summary ? fallbackLang(lang, pub.summary_is) : undefined;
const byline = [pub.venue, pub.year].filter(Boolean).join(' · ');
---
<details class="pub-disclosure border-t border-rule-soft last:border-b last:border-b-rule-soft py-4">
  <summary class="grid grid-cols-[1fr_auto] items-start gap-x-4 gap-y-[0.4375rem] cursor-pointer list-none">
    <div class="col-start-1 flex flex-col gap-[0.4375rem]">
      <ThemeTag theme={pub.theme} lang={lang} />
      <span class="pub-title font-display text-lg md:text-xl font-normal leading-[1.3] text-ink">
        {pub.title}
      </span>
      <span class="font-prose italic text-[0.9375rem] leading-[1.4] text-ink-muted">
        {pub.authors.map((a, i) => (
          <Fragment>
            {isYou(a) ? <strong class="font-medium text-ink">{formatAuthor(a)}</strong> : formatAuthor(a)}
            {i < pub.authors.length - 1 ? ', ' : ''}
          </Fragment>
        ))}
        {byline && <Fragment> · {byline}</Fragment>}
      </span>
    </div>
    <!-- The design leaves disclosure rows unmarked; a hairline mono glyph
         costs nothing and is the difference between "there is more here"
         being discoverable and being guessed at. -->
    <span class="pub-marker meta col-start-2 row-start-1 mt-1 select-none" aria-hidden="true">+</span>
  </summary>

  {summary && (
    <p class="mt-3.5 prose-body text-[1rem] leading-[1.6] text-ink-muted" lang={summaryLang}>{summary}</p>
  )}

  {(links.length > 0 || pub.bibtex) && (
    <ul class="mt-3 flex flex-wrap items-baseline gap-3.5">
      {links.map((l) => (
        <li>
          <a href={pub.links[l.key]} class="font-mono text-xs">{l.label} →</a>
        </li>
      ))}
      {pub.bibtex && <li class="basis-full sm:basis-auto"><CiteButton bibtex={pub.bibtex} lang={lang} /></li>}
    </ul>
  )}
</details>

<style>
  /* Safari still paints its own triangle unless this pseudo-element is
     suppressed; `list-style: none` alone is not enough there. */
  .pub-disclosure summary::-webkit-details-marker {
    display: none;
  }
  .pub-disclosure summary:hover .pub-title {
    color: var(--color-accent-primary);
  }
  .pub-disclosure summary:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 3px;
  }
  .pub-disclosure[open] .pub-marker {
    /* An en dash, not a hyphen — it optically matches the "+" stroke. */
    font-size: 0;
  }
  .pub-disclosure[open] .pub-marker::after {
    content: '–';
    font-size: 0.75rem;
  }
</style>
