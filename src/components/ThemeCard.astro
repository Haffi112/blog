---
import type { Theme } from '~/data/publications.schema';
import ThemeTag from './ThemeTag.astro';
import { localizePath, useTranslations, type Lang } from '~/i18n/utils';

/**
 * One research theme on /research/: a hairline row, not a box — the tinted
 * theme tag above the title is the same one each publication carries, so
 * the colour links the two pages. The link names how many publications
 * the theme has and jumps to them.
 */
interface Props {
  theme: Theme; // also the anchor of its section on the publications page
  title: string;
  body: string;
  /** Publications filed under this theme. */
  count: number;
  lang?: Lang;
}
const { theme, title, body, count, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---
<article class="py-7 border-t border-rule-soft first:border-t-0">
  <ThemeTag theme={theme} lang={lang} />
  <h3 class="mt-2 text-[1.4375rem] font-normal leading-[1.25] text-ink text-balance">{title}</h3>
  <p class="mt-2.5 prose-body max-w-prose text-pretty">{body}</p>
  {count > 0 && (
    <p class="mt-3.5">
      <a href={localizePath(`/publications/#${theme}`, lang)} class="font-mono text-xs">{t.publications.count(count)} →</a>
    </p>
  )}
</article>
