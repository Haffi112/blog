---
interface Props {
  scripts: string[]; // public-relative paths, e.g. ['/js/d3/d3.min.js', '/js/lif_neuron.js']
  styles?: string[]; // public-relative paths
  /** Accessible name for the scrollable region. */
  label?: string;
}

const { scripts, styles = [], label = 'Interactive simulation' } = Astro.props;
---
{styles.map((href) => <link rel="stylesheet" href={href} />)}
<div
  class="my-8 border border-rule bg-bg-elev p-4 overflow-x-auto focus-visible:outline-2 focus-visible:outline-accent-primary focus-visible:outline-offset-2"
  role="region"
  aria-label={label}
  tabindex="0"
>
  <slot />
</div>
{scripts.map((src) => <script is:inline defer src={src}></script>)}
