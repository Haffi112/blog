---
import { Picture } from 'astro:assets';
import GraphField from './GraphField.astro';
import hafsteinnPhoto from '~/assets/hafsteinn.png';
---
<section class="relative overflow-hidden border-b border-rule">
  <!-- Animated knowledge-graph field, faded into the page background so
       the hero text stays readable and the section ends cleanly. -->
  <div class="absolute inset-0" aria-hidden="true">
    <GraphField />
    <div class="absolute inset-0 bg-linear-to-b from-bg/55 via-bg/25 to-bg"></div>
  </div>

  <div class="relative max-w-page mx-auto px-6 pt-20 pb-16 md:pt-28 md:pb-24">
    <div class="flex flex-col md:flex-row md:items-center gap-10 md:gap-14">
      <div class="max-w-2xl shrink rounded-card bg-bg/60 backdrop-blur-[3px] p-6 md:p-8 -m-6 md:-m-8">
        <p class="eyebrow">Machine learning research</p>
        <h1 class="mt-4 text-display font-semibold text-ink">
          Hafsteinn Einarsson
        </h1>
        <p class="mt-4 text-lg text-ink-muted">
          Associate Professor, University of Iceland<br />
          Research Scientist, Amgen deCODE
        </p>
        <p class="mt-6 prose-body max-w-prose">
          I lead a research group working on natural language processing for
          Icelandic and Faroese, with active projects in computer vision for
          the natural sciences, clinical AI, and human genetics.
        </p>
        <ul class="mt-8 flex flex-wrap gap-x-7 gap-y-3 text-sm font-medium">
          <li><a href="/research/">Research →</a></li>
          <li><a href="/publications/">Publications →</a></li>
          <li><a href="/cv.pdf">Download CV ↓</a></li>
        </ul>
      </div>
      <Picture
        src={hafsteinnPhoto}
        alt="Hafsteinn Einarsson"
        width={200}
        height={250}
        densities={[1, 2]}
        formats={['avif', 'webp']}
        fallbackFormat="png"
        class="w-36 md:w-44 lg:w-50 shrink-0 rounded-card border border-rule shadow-sm"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
