---
import type { Theme } from '~/data/publications.schema';
import { themeByCode } from '~/data/themes';
import type { Lang } from '~/i18n/utils';

/**
 * Research-theme label. The redesign drops the pill entirely: the tag is a
 * line of letterspaced mono caps sitting above the title, tinted by theme.
 * Rust is the house accent and carries the two flagship strands; the
 * remaining themes step down through the warm secondary and plain ink so
 * the list never reads as a colour chart. Label text lives in
 * src/data/themes.ts (both languages).
 */
interface Props {
  theme?: Theme;
  size?: 'sm' | 'md';
  lang?: Lang;
}

const { theme, size = 'sm', lang = 'en' } = Astro.props;

const tone: Record<Theme, string> = {
  'nlp-is': 'text-accent-primary',
  'cv-nat': 'text-accent-energy',
  'clinical-ai': 'text-accent-warm',
  genetics: 'text-ink-muted',
  'comp-neuro': 'text-accent-warm',
  'discrete-math': 'text-ink-muted'
};

const label = theme ? themeByCode[theme].tag[lang] : null;
---
{theme && label && (
  <span
    class:list={[
      'inline-block font-mono uppercase leading-none',
      size === 'sm'
        ? 'text-[0.6875rem] tracking-[0.1em]'
        : 'text-xs tracking-[0.12em]',
      tone[theme]
    ]}
  >{label}</span>
)}
