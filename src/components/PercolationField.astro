---
/**
 * PercolationField — bootstrap percolation on a drifting random geometric
 * graph, rendered behind the hero.
 *
 * The model (a nod to the PhD work on bootstrap percolation with
 * inhibition, and to the 2016 blog posts):
 *
 *  - Nodes drift on a bounded plane and rewire continuously: the edge set
 *    is rebuilt from scratch every ~0.55 s, so an edge exists exactly
 *    while two nodes are within RADIUS of one another. The topology is
 *    part of the animation, not a fixed backdrop.
 *  - A node fires when THRESH (= 2) of its neighbours have delivered a
 *    spike inside the DECAY window — the bootstrap rule. Partial charge is
 *    drawn as an arc filling toward the threshold, and leaks away if the
 *    second spike never arrives.
 *  - Firing sends spikes along up to six incident edges as travelling
 *    particles, then drops the node into a refractory pause (drawn as a
 *    recovery arc). The refractory state is what makes cascades either die
 *    out or sweep the graph and stop, instead of reverberating forever.
 *  - Transit delays are deterministic (distance / MSG_V) by default, or
 *    drawn from an Exp(1/mean) when the "exponential delays" toggle is on —
 *    the difference between a synchronous and an asynchronous cascade,
 *    which is visible as fronts going from crisp to ragged.
 *
 * Interaction: click ignites the nearest rested node; holding grows an
 * ignition front that keeps seeding nodes inside it. Optional ambient
 * auto-triggering, and optional audio — each node holds a fixed pitch
 * drawn from an A-minor pentatonic field over the plane, so neighbouring
 * nodes (which are the ones that fire in sequence) land on consonant
 * intervals.
 *
 * Performance / accessibility contract (unchanged from the field this
 * replaces):
 *  - no dependencies; the whole thing is this inline script
 *  - devicePixelRatio-aware, capped at 2
 *  - animation pauses when the canvas leaves the viewport or the tab hides
 *  - prefers-reduced-motion gets a single static frame and no controls
 *  - colors come from the theme's CSS custom properties and re-resolve
 *    when data-theme changes, so the field matches light/dark/reader
 *  - audio is opt-in and only ever constructed inside a click handler, so
 *    no AudioContext is created without a user gesture
 *  - without JavaScript the canvas stays blank and the controls are
 *    hidden; hero content is unaffected
 */
---
<div class="absolute inset-0" data-perc-root>
  <canvas data-perc-canvas class="w-full h-full block" aria-hidden="true"></canvas>

  <!-- Readability wash: a soft radial lift over the side the hero type
       sits on, plus a fade into the page background at the bottom edge so
       the full-bleed section ends cleanly. -->
  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="background:
      radial-gradient(120% 90% at 12% 45%, color-mix(in oklch, var(--color-bg) 34%, transparent) 0%, color-mix(in oklch, var(--color-bg) 16%, transparent) 50%, transparent 80%),
      linear-gradient(to bottom, transparent 60%, color-mix(in oklch, var(--color-bg) 55%, transparent) 88%, var(--color-bg) 100%);"
  ></div>

  <div
    data-perc-controls
    hidden
    class="absolute z-20 right-4 top-4 md:right-6 md:top-5 flex flex-col items-end gap-2.5"
  >
    <button
      type="button"
      data-perc-toggle-panel
      aria-expanded="false"
      aria-controls="perc-panel"
      aria-label="About this animation"
      class="order-1 inline-flex items-center justify-center w-7 h-7 rounded-full border border-ink/25 bg-bg/70 backdrop-blur-[2px] font-display italic text-sm leading-none text-ink-muted hover:border-ink/50 hover:text-ink transition-colors cursor-help"
    >i</button>

    <div
      id="perc-panel"
      data-perc-panel
      hidden
      class="perc-panel order-2 w-[min(84vw,22.5rem)] p-5 bg-bg/95 border border-ink/15 backdrop-blur-[3px]"
    >
      <p class="prose-body text-[0.96875rem] leading-[1.55] text-ink-muted">
        Nodes drift and rewire; a node fires once two of its neighbours have
        fired within a short window, then falls into a refractory pause.
        Cascades either die out or sweep the graph. Inspired by my PhD work
        on bootstrap percolation with inhibition.
      </p>
      <p class="mt-3 eyebrow text-[0.65625rem] tracking-[0.08em] text-ink-faint">
        Click to ignite · hold to widen the ignition front
      </p>
      <div class="mt-3.5 flex flex-wrap gap-2">
        <button type="button" data-perc-toggle="sound" aria-pressed="false" class="perc-chip">
          <span class="perc-dot" aria-hidden="true"></span>
          <span data-perc-label>Sound off</span>
        </button>
        <button type="button" data-perc-toggle="auto" aria-pressed="false" class="perc-chip">
          <span class="perc-dot" aria-hidden="true"></span>
          <span data-perc-label>Auto-trigger off</span>
        </button>
        <button type="button" data-perc-toggle="delay" aria-pressed="false" class="perc-chip">
          <span class="perc-dot" aria-hidden="true"></span>
          <span data-perc-label>Delays · fixed</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Kept out of the class list because the shadow colour is a color-mix()
     whose commas Tailwind's arbitrary-value parser would split on. */
  .perc-panel {
    box-shadow: 0 14px 34px color-mix(in oklch, var(--color-ink) 14%, transparent);
  }

  .perc-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.4375rem 0.6875rem;
    border: 1px solid color-mix(in oklch, var(--color-ink) 22%, transparent);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.65625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    cursor: pointer;
    transition: border-color var(--motion-fast) var(--ease-out);
  }
  .perc-chip:hover {
    border-color: color-mix(in oklch, var(--color-ink) 50%, transparent);
  }
  .perc-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: color-mix(in oklch, var(--color-ink) 22%, transparent);
    transition: background-color var(--motion-fast) var(--ease-out);
  }
  .perc-chip[aria-pressed='true'] .perc-dot {
    background: var(--color-accent-energy);
  }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-perc-root]');
    if (!root) return;
    const canvas = root.querySelector('[data-perc-canvas]');
    const ctx = canvas && canvas.getContext('2d');
    if (!ctx) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    /* ---- Theme colours ---------------------------------------------------
       Probe computed `color` so oklch()/color-mix() tokens collapse into a
       plain rgb() string every canvas implementation accepts, then keep the
       numeric components around for the many rgba(...) strokes below. */
    let inkRGB = '28,26,23';
    let accent = 'rgb(182,76,43)';
    const resolveColors = () => {
      const probe = document.createElement('span');
      probe.style.display = 'none';
      document.body.appendChild(probe);
      const grab = (token) => {
        probe.style.color = `var(${token})`;
        return getComputedStyle(probe).color;
      };
      const ink = grab('--color-ink');
      const m = /(-?[\d.]+)[,\s]+(-?[\d.]+)[,\s]+(-?[\d.]+)/.exec(ink);
      if (m) inkRGB = `${Math.round(+m[1])},${Math.round(+m[2])},${Math.round(+m[3])}`;
      accent = grab('--color-accent-energy') || accent;
      probe.remove();
    };
    resolveColors();

    /* ---- Model constants (from the design) ------------------------------ */
    const FIRE = 0.34;      // s — how long a node stays in the firing state
    const REFRAC = 3.1;     // s — refractory pause after firing
    const DECAY = 2.6;      // s — how long partial charge lingers
    const MSG_V = 150;      // px/s — spike transit speed
    const RADIUS = 132;     // px — edge existence radius
    const THRESH = 2;       // bootstrap threshold
    const DENSITY = 1.5;    // nodes per 11000 px², scaled
    const BURST = 1;        // spark-particle multiplier
    const RELINK = 0.55;    // s — how often the edge set is rebuilt
    const FANOUT = 6;       // max incident edges a firing node transmits on

    let W = 0, H = 0;
    let nodes = [], edges = [], msgs = [], pulses = [], sparks = [], flashes = [];
    let sinceLink = 0, ambient = 1.2, mouseCool = 0;
    const hold = { on: false, x: 0, y: 0, r: 0, acc: 0 };

    /* User-controlled modes. */
    const mode = { sound: false, auto: false, expDelay: false };

    /* ---- Audio (opt-in, built lazily inside a click handler) ------------ */
    let actx = null, master = null, lastNote = 0;
    const initAudio = () => {
      if (!actx) {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return;
        actx = new AC();
        master = actx.createGain();
        master.gain.value = 0.16;
        const lp = actx.createBiquadFilter();
        lp.type = 'lowpass';
        lp.frequency.value = 3400;
        lp.Q.value = 0.4;
        /* A short feedback delay stands in for a room — cheaper than a
           convolver and enough to keep plucks from sounding clinical. */
        const verb = actx.createDelay(0.3);
        verb.delayTime.value = 0.19;
        const vg = actx.createGain();
        vg.gain.value = 0.24;
        master.connect(lp);
        lp.connect(actx.destination);
        lp.connect(verb);
        verb.connect(vg);
        vg.connect(lp);
      }
      if (actx.state === 'suspended') actx.resume();
    };

    /* Short plucked tone. `gen` is the cascade depth: seeds are louder than
       the nodes they recruit, so a sweep is audible as a decrescendo. */
    const playTone = (freq, gen) => {
      if (!mode.sound || !actx) return;
      const now = actx.currentTime;
      if (now - lastNote < 0.035) return; // rate-limit dense cascades
      lastNote = now;
      const o1 = actx.createOscillator();
      const o2 = actx.createOscillator();
      const g = actx.createGain();
      o1.type = 'triangle';
      o2.type = 'sine';
      o1.frequency.value = freq;
      o2.frequency.value = freq * 2.002; // slight detune → gentle beating
      const peak = gen === 0 ? 0.5 : 0.3;
      g.gain.setValueAtTime(0.0001, now);
      g.gain.exponentialRampToValueAtTime(peak, now + 0.012);
      g.gain.exponentialRampToValueAtTime(0.0001, now + 1.5);
      const g2 = actx.createGain();
      g2.gain.value = 0.3;
      o1.connect(g);
      o2.connect(g2);
      g2.connect(g);
      g.connect(master);
      o1.start(now);
      o2.start(now);
      o1.stop(now + 1.6);
      o2.stop(now + 1.6);
    };

    /* ---- Graph construction --------------------------------------------- */
    const build = () => {
      const r = canvas.getBoundingClientRect();
      if (!r.width || !r.height) return false;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      W = r.width;
      H = r.height;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.max(18, Math.round(((W * H) / 11000) * DENSITY));
      /* A-minor pentatonic across three octaves. Pitch is a smooth function
         of birth position, so graph neighbours — the nodes that actually
         fire in sequence — land on consonant intervals. */
      const SEMI = [0, 3, 5, 7, 10];
      const ph1 = Math.random() * 6.28;
      const ph2 = Math.random() * 6.28;
      const toneAt = (x, y) => {
        const f =
          1.9 * Math.sin((x / W) * 3.1 + ph1) +
          1.9 * Math.cos((y / H) * 2.3 + ph2) +
          0.9 * Math.sin(((x + y) / (W + H)) * 5.7 + ph1 * 0.5);
        const d = Math.max(0, Math.min(13, Math.round(f + 6.5)));
        const midi = 45 + Math.floor(d / 5) * 12 + SEMI[d % 5];
        return 440 * Math.pow(2, (midi - 69) / 12);
      };

      nodes = [];
      for (let i = 0; i < count; i++) {
        const x = Math.random() * W;
        const y = Math.random() * H;
        nodes.push({
          x, y,
          vx: (Math.random() - 0.5) * 15,
          vy: (Math.random() - 0.5) * 15,
          st: 0,        // 0 rest · 1 firing · 2 refractory
          t: 0,
          charge: 0,
          ct: 0,
          gen: 0,
          nb: [],
          freq: toneAt(x, y)
        });
      }
      msgs = [];
      pulses = [];
      sparks = [];
      flashes = [];
      link();
      return true;
    };

    /* Rebuild the edge set from current positions. O(n²), but n is ~100 and
       this runs a couple of times a second, not per frame. */
    const link = () => {
      edges = [];
      for (const nd of nodes) nd.nb = [];
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const d2 = dx * dx + dy * dy;
          if (d2 >= RADIUS * RADIUS) continue;
          edges.push([i, j]);
          nodes[i].nb.push(j);
          nodes[j].nb.push(i);
        }
      }
    };

    /* ---- Firing ---------------------------------------------------------- */
    const fire = (i, gen) => {
      const nd = nodes[i];
      if (!nd || nd.st !== 0) return;
      const g = gen || 0;
      nd.st = 1;
      nd.t = 0;
      nd.charge = 0;
      nd.ct = 0;
      nd.gen = g;
      playTone(nd.freq, g);
      pulses.push({ x: nd.x, y: nd.y, t: 0, big: g === 0 });

      const cnt = Math.round((g === 0 ? 16 : 9) * BURST);
      const a0 = Math.random() * Math.PI * 2;
      for (let k = 0; k < cnt; k++) {
        const a = a0 + (k / cnt) * Math.PI * 2 + (Math.random() - 0.5) * 0.7;
        const sp = 42 + Math.random() * 108 * (g === 0 ? 1.25 : 1);
        sparks.push({
          x: nd.x, y: nd.y,
          vx: Math.cos(a) * sp,
          vy: Math.sin(a) * sp,
          t: 0,
          life: 0.42 + Math.random() * 0.5,
          r: 0.7 + Math.random() * 1.5,
          spin: Math.random() < 0.22
        });
      }

      for (const j of nd.nb.slice(0, FANOUT)) {
        if (nodes[j].st !== 0) continue;
        const d = Math.hypot(nodes[j].x - nd.x, nodes[j].y - nd.y);
        const mean = Math.max(0.16, d / MSG_V);
        /* Inverse-transform sampling of Exp(1/mean) when asynchronous
           delays are on; otherwise the deterministic transit time. */
        const dur = mode.expDelay
          ? Math.min(2.4, Math.max(0.05, -mean * Math.log(1 - Math.random())))
          : mean;
        msgs.push({ a: i, b: j, p: 0, dur, g });
        flashes.push({ a: i, b: j, t: 0 });
      }
    };

    /* ---- Integration ----------------------------------------------------- */
    const step = (dt) => {
      for (const nd of nodes) {
        nd.x += nd.vx * dt;
        nd.y += nd.vy * dt;
        if (nd.x < 4 || nd.x > W - 4) { nd.vx *= -1; nd.x = Math.min(W - 4, Math.max(4, nd.x)); }
        if (nd.y < 4 || nd.y > H - 4) { nd.vy *= -1; nd.y = Math.min(H - 4, Math.max(4, nd.y)); }
        nd.t += dt;
        if (nd.st === 1 && nd.t > FIRE) { nd.st = 2; nd.t = 0; }
        else if (nd.st === 2 && nd.t > REFRAC) { nd.st = 0; nd.t = 0; }
        if (nd.st === 0 && nd.charge > 0) {
          nd.ct += dt;
          if (nd.ct > DECAY) { nd.charge = 0; nd.ct = 0; }
        }
      }

      for (let k = msgs.length - 1; k >= 0; k--) {
        const m = msgs[k];
        m.p += dt / m.dur;
        if (m.p < 1) continue;
        msgs.splice(k, 1);
        const tgt = nodes[m.b];
        if (!tgt || tgt.st !== 0) continue;
        tgt.charge++;
        tgt.ct = 0;
        sparks.push({ x: tgt.x, y: tgt.y, vx: 0, vy: 0, t: 0, life: 0.3, r: 2.4, ring: true });
        if (tgt.charge >= THRESH) fire(m.b, (m.g || 0) + 1);
      }

      for (let k = pulses.length - 1; k >= 0; k--) {
        pulses[k].t += dt;
        if (pulses[k].t > 0.9) pulses.splice(k, 1);
      }
      for (let k = flashes.length - 1; k >= 0; k--) {
        flashes[k].t += dt;
        if (flashes[k].t > 0.45) flashes.splice(k, 1);
      }
      for (let k = sparks.length - 1; k >= 0; k--) {
        const s = sparks[k];
        s.t += dt;
        if (s.t > s.life) { sparks.splice(k, 1); continue; }
        if (s.ring) continue;
        s.x += s.vx * dt;
        s.y += s.vy * dt;
        s.vx *= 1 - 2.6 * dt;
        s.vy *= 1 - 2.6 * dt;
        s.vy += 14 * dt; // a whisper of gravity so bursts settle
      }

      sinceLink += dt;
      if (sinceLink > RELINK) { sinceLink = 0; link(); }

      /* Held-pointer ignition front: a growing disc that keeps seeding a
         fraction of the rested nodes it covers. */
      if (hold.on) {
        hold.r = Math.min(300, hold.r + 190 * dt);
        hold.acc += dt;
        if (hold.acc > 0.055) {
          hold.acc = 0;
          const cand = [];
          for (let i = 0; i < nodes.length; i++) {
            if (nodes[i].st !== 0) continue;
            if (Math.hypot(nodes[i].x - hold.x, nodes[i].y - hold.y) < hold.r) cand.push(i);
          }
          if (cand.length) {
            const n = Math.max(1, Math.round(cand.length * 0.16));
            for (let k = 0; k < n; k++) fire(cand[(Math.random() * cand.length) | 0]);
          }
        }
      }

      /* Ambient seeding: two adjacent seeds, so their shared neighbours can
         actually reach the K=2 threshold and the wave has somewhere to go. */
      ambient -= dt;
      if (mode.auto && ambient <= 0) {
        ambient = 2.4 + Math.random() * 2.2;
        const cand = [];
        for (let i = 0; i < nodes.length; i++) {
          if (nodes[i].st === 0 && nodes[i].nb.length >= 2) cand.push(i);
        }
        if (cand.length) {
          const i = cand[(Math.random() * cand.length) | 0];
          fire(i);
          const nb = nodes[i].nb.filter((j) => nodes[j].st === 0);
          if (nb.length) fire(nb[(Math.random() * nb.length) | 0]);
        }
      }

      if (mouseCool > 0) mouseCool -= dt;
    };

    /* ---- Rendering -------------------------------------------------------- */
    const TAU = Math.PI * 2;
    const draw = () => {
      ctx.clearRect(0, 0, W, H);
      ctx.save();

      /* Edges: one batched path at low alpha, so the mesh reads as texture
         rather than wireframe and costs a single stroke call. */
      ctx.globalAlpha = 0.62;
      ctx.lineWidth = 1;
      ctx.strokeStyle = `rgba(${inkRGB},0.075)`;
      ctx.beginPath();
      for (const e of edges) {
        ctx.moveTo(nodes[e[0]].x, nodes[e[0]].y);
        ctx.lineTo(nodes[e[1]].x, nodes[e[1]].y);
      }
      ctx.stroke();

      if (hold.on) {
        ctx.strokeStyle = accent;
        ctx.globalAlpha = 0.3;
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.arc(hold.x, hold.y, hold.r, 0, TAU);
        ctx.stroke();
        ctx.globalAlpha = 0.06;
        ctx.fillStyle = accent;
        ctx.fill();
      }

      /* Edge flashes on links currently transmitting. */
      ctx.lineWidth = 1.2;
      ctx.strokeStyle = accent;
      for (const f of flashes) {
        const a = nodes[f.a], b = nodes[f.b];
        if (!a || !b) continue;
        ctx.globalAlpha = 0.3 * (1 - f.t / 0.45);
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
      }

      /* Expanding rings at each firing site; seeds get a second ring. */
      ctx.strokeStyle = accent;
      for (const p of pulses) {
        const k = p.t / 0.9;
        const e = 1 - Math.pow(1 - k, 3);
        ctx.globalAlpha = (p.big ? 0.4 : 0.28) * (1 - k);
        ctx.lineWidth = (p.big ? 1.8 : 1.3) * (1 - k * 0.6);
        ctx.beginPath();
        ctx.arc(p.x, p.y, 4 + e * (p.big ? 40 : 26), 0, TAU);
        ctx.stroke();
        if (p.big && k < 0.55) {
          ctx.globalAlpha = 0.22 * (1 - k / 0.55);
          ctx.beginPath();
          ctx.arc(p.x, p.y, 4 + e * 62, 0, TAU);
          ctx.stroke();
        }
      }

      /* Spark particles: a few are drawn as motion streaks. */
      for (const s of sparks) {
        const k = s.t / s.life;
        if (s.ring) {
          ctx.strokeStyle = accent;
          ctx.globalAlpha = 0.5 * (1 - k);
          ctx.lineWidth = 1.2;
          ctx.beginPath();
          ctx.arc(s.x, s.y, 3 + k * 7, 0, TAU);
          ctx.stroke();
          continue;
        }
        ctx.globalAlpha = 0.85 * (1 - k * k);
        if (s.spin) {
          ctx.strokeStyle = accent;
          ctx.lineWidth = 0.9;
          const len = 3 + s.r * 2;
          const m = Math.hypot(s.vx, s.vy) || 1;
          ctx.beginPath();
          ctx.moveTo(s.x, s.y);
          ctx.lineTo(s.x - (s.vx / m) * len, s.y - (s.vy / m) * len);
          ctx.stroke();
        } else {
          ctx.fillStyle = accent;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r * (1 - k * 0.55), 0, TAU);
          ctx.fill();
        }
      }

      /* Nodes: firing (glow), refractory (recovery arc), rested (dot, plus
         a charge arc showing progress toward the threshold). */
      for (const nd of nodes) {
        if (nd.st === 1) {
          const k = 1 - nd.t / FIRE;
          ctx.fillStyle = accent;
          ctx.globalAlpha = 0.18 + 0.22 * k;
          ctx.beginPath();
          ctx.arc(nd.x, nd.y, 9, 0, TAU);
          ctx.fill();
          ctx.globalAlpha = 1;
          ctx.beginPath();
          ctx.arc(nd.x, nd.y, 4.2, 0, TAU);
          ctx.fill();
        } else if (nd.st === 2) {
          const k = Math.min(1, nd.t / REFRAC);
          ctx.globalAlpha = 1;
          ctx.fillStyle = `rgba(${inkRGB},0.11)`;
          ctx.beginPath();
          ctx.arc(nd.x, nd.y, 3, 0, TAU);
          ctx.fill();
          ctx.strokeStyle = `rgba(${inkRGB},0.18)`;
          ctx.lineWidth = 1.3;
          ctx.beginPath();
          ctx.arc(nd.x, nd.y, 6.5, -Math.PI / 2, -Math.PI / 2 + k * TAU);
          ctx.stroke();
        } else {
          ctx.globalAlpha = 1;
          ctx.fillStyle = `rgba(${inkRGB},0.22)`;
          ctx.beginPath();
          ctx.arc(nd.x, nd.y, 2.7, 0, TAU);
          ctx.fill();
          if (nd.charge > 0) {
            ctx.strokeStyle = accent;
            ctx.globalAlpha = 0.6;
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.arc(nd.x, nd.y, 6, -Math.PI / 2, -Math.PI / 2 + (nd.charge / THRESH) * TAU);
            ctx.stroke();
          }
        }
      }

      /* Spikes in transit. */
      ctx.fillStyle = accent;
      for (const m of msgs) {
        const a = nodes[m.a], b = nodes[m.b];
        if (!a || !b) continue;
        const x = a.x + (b.x - a.x) * m.p;
        const y = a.y + (b.y - a.y) * m.p;
        ctx.globalAlpha = 0.85;
        ctx.beginPath();
        ctx.arc(x, y, 1.9, 0, TAU);
        ctx.fill();
        ctx.globalAlpha = 0.25;
        ctx.beginPath();
        ctx.arc(x, y, 4.5, 0, TAU);
        ctx.fill();
      }

      ctx.restore();
    };

    /* ---- Loop ------------------------------------------------------------- */
    let raf = 0, visible = false, last = 0, ready = false;
    const loop = (now) => {
      const dt = Math.min(0.05, last ? (now - last) / 1000 : 0.016);
      last = now;
      step(dt);
      draw();
      raf = requestAnimationFrame(loop);
    };
    const start = () => {
      if (raf || !ready || reduced.matches || !visible || document.hidden) return;
      last = 0;
      raf = requestAnimationFrame(loop);
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };

    /* ---- Pointer ---------------------------------------------------------- */
    /* Listen on the enclosing section, not the canvas: the hero content
       stacks above the canvas layer, so a click on the headline would never
       reach the canvas — but it bubbles through the section. */
    const host = canvas.closest('section') || root;
    const at = (e) => {
      const r = canvas.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    };
    /* Clicks on real controls are theirs alone — no ignition front under a
       link the visitor is trying to follow. */
    const isChrome = (e) => !!(e.target && e.target.closest && e.target.closest('a,button'));

    const ignite = (p) => {
      if (mouseCool > 0) return;
      let best = -1, bd = 1e9;
      for (let i = 0; i < nodes.length; i++) {
        const d = Math.hypot(nodes[i].x - p.x, nodes[i].y - p.y);
        if (d < bd) { bd = d; best = i; }
      }
      if (best >= 0 && bd < 110 && nodes[best].st === 0) {
        fire(best);
        mouseCool = 0.12;
      }
    };

    const onDown = (e) => {
      if (isChrome(e)) return;
      const p = at(e);
      hold.on = true; hold.x = p.x; hold.y = p.y; hold.r = 34; hold.acc = 0;
      ignite(p);
    };
    const onUp = () => { hold.on = false; hold.r = 0; };
    const onMove = (e) => {
      if (!hold.on) return;
      const p = at(e);
      hold.x = p.x;
      hold.y = p.y;
    };
    const onTouch = (e) => {
      if (isChrome(e)) return;
      const t0 = e.touches && e.touches[0];
      if (!t0) return;
      const p = at({ clientX: t0.clientX, clientY: t0.clientY });
      hold.on = true; hold.x = p.x; hold.y = p.y;
      if (hold.r < 34) hold.r = 34;
      ignite(p);
    };

    host.addEventListener('mousemove', onMove);
    host.addEventListener('mousedown', onDown);
    host.addEventListener('mouseleave', onUp);
    window.addEventListener('mouseup', onUp);
    host.addEventListener('touchstart', onTouch, { passive: true });
    host.addEventListener('touchmove', onTouch, { passive: true });
    host.addEventListener('touchend', onUp);

    /* ---- Controls --------------------------------------------------------- */
    const controls = root.querySelector('[data-perc-controls]');
    const panel = root.querySelector('[data-perc-panel]');
    const panelBtn = root.querySelector('[data-perc-toggle-panel]');

    const LABELS = {
      sound: ['Sound off', 'Sound on'],
      auto: ['Auto-trigger off', 'Auto-trigger on'],
      delay: ['Delays · fixed', 'Delays · exponential']
    };
    const KEY = { sound: 'sound', auto: 'auto', delay: 'expDelay' };

    root.querySelectorAll('[data-perc-toggle]').forEach((btn) => {
      const id = btn.dataset.percToggle;
      btn.addEventListener('click', () => {
        const next = !mode[KEY[id]];
        mode[KEY[id]] = next;
        btn.setAttribute('aria-pressed', next ? 'true' : 'false');
        const label = btn.querySelector('[data-perc-label]');
        if (label) label.textContent = LABELS[id][next ? 1 : 0];
        /* The AudioContext is constructed here and nowhere else, so it is
           always inside a user gesture and never autoplay-blocked. */
        if (id === 'sound' && next) initAudio();
      });
    });

    if (panelBtn && panel) {
      const setPanel = (open) => {
        panel.hidden = !open;
        panelBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      panelBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        setPanel(panel.hidden);
      });
      /* Keep the panel from swallowing hero clicks, and close on outside
         click or Escape. */
      panel.addEventListener('mousedown', (e) => e.stopPropagation());
      document.addEventListener('click', (e) => {
        if (!panel.hidden && !controls.contains(e.target)) setPanel(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !panel.hidden) {
          setPanel(false);
          panelBtn.focus();
        }
      });
    }

    /* Controls only make sense when the field is actually running. */
    if (controls && !reduced.matches) controls.hidden = false;

    /* ---- Lifecycle -------------------------------------------------------- */
    new MutationObserver(() => {
      resolveColors();
      if (!raf && ready) draw();
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme']
    });

    const io = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      visible ? start() : stop();
    });
    io.observe(canvas);

    document.addEventListener('visibilitychange', () => {
      document.hidden ? stop() : start();
    });

    reduced.addEventListener('change', () => {
      if (controls) controls.hidden = reduced.matches;
      if (reduced.matches) { stop(); if (ready) draw(); } else start();
    });

    /* ResizeObserver rather than an eager build(): this script runs
       mid-parse, before the hero has its final height, so measuring now
       would yield a zero-sized canvas. */
    let resizeTimer = 0;
    new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        if (build()) {
          ready = true;
          if (raf) return;
          /* Reduced motion (or an off-screen hero) gets one static frame. */
          reduced.matches || !visible || document.hidden ? draw() : start();
        }
      }, 100);
    }).observe(canvas);
  })();
</script>
