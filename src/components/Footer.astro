---
import { aiSeries } from '~/data/series';
import { localizePath, useTranslations, type Lang } from '~/i18n/utils';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const exploreLinks = [
  { href: '/research/', label: t.nav.research },
  { href: '/publications/', label: t.nav.publications },
  { href: '/teaching/', label: t.nav.teaching },
  { href: '/group/', label: t.nav.group },
  { href: '/writing/', label: t.nav.writing },
  { href: '/about/', label: t.nav.about }
].map((l) => ({ ...l, href: localizePath(l.href, lang) }));
const profileLinks = [
  { href: 'https://scholar.google.com/citations?user=QH69Qk8AAAAJ&hl=en', label: 'Google Scholar' },
  { href: 'https://orcid.org/0000-0001-5072-3678', label: 'ORCID' },
  { href: 'https://github.com/Haffi112', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/hafsteinn-einarsson-619a3711', label: 'LinkedIn' },
  { href: 'https://twitter.com/hafsteinn', label: 'X' },
  { href: aiSeries.youtubeChannel, label: 'YouTube' },
  { href: aiSeries.tiktok, label: 'TikTok' },
  { href: localizePath('/atom.xml', lang), label: 'RSS' }
];
const year = new Date().getFullYear();
---
<!-- The footer sits on the warmer paper tone (base-200), which in this
     palette is a shade *darker* than the page — the design's #f1ede4. -->
<footer class="border-t border-rule mt-24 bg-bg-elev">
  <div class="max-w-page mx-auto px-6 py-10 md:px-10 md:py-12 grid gap-8 md:gap-12 sm:grid-cols-2 lg:grid-cols-3">
    <div class="max-w-xs">
      <p class="font-display text-[1.1875rem] text-ink">
        Hafsteinn Einarsson
      </p>
      <p class="mt-3 font-prose text-[1rem] leading-[1.55] text-ink-muted max-w-[34ch]">
        {t.footer.blurb}
      </p>
      <p class="meta mt-6">© {year} Hafsteinn Einarsson</p>
    </div>
    <nav aria-label={t.footer.sectionsLabel}>
      <p class="eyebrow text-ink-faint">{t.footer.explore}</p>
      <ul class="mt-3.5 flex flex-col gap-2.5 font-mono text-[0.78125rem]">
        {exploreLinks.map((l) => (
          <li><a href={l.href} class="text-ink-muted hover:text-ink">{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <nav aria-label={t.footer.profilesLabel}>
      <p class="eyebrow text-ink-faint">{t.footer.elsewhere}</p>
      <ul class="mt-3.5 flex flex-col gap-2.5 font-mono text-[0.78125rem]">
        {profileLinks.map((l) => (
          <li><a href={l.href} class="text-ink-muted hover:text-ink">{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="border-t border-rule">
    <div class="max-w-page mx-auto px-6 md:px-10 py-4 flex justify-end">
      <a href="/cv.pdf" hreflang={lang === 'en' ? undefined : 'en'} class="meta hover:text-ink">{t.footer.downloadCv}</a>
    </div>
  </div>
</footer>
