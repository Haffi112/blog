---
import BaseLayout from '~/components/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import { useTranslations, type Lang } from '~/i18n/utils';

/* CV page body, shared by /cv/ and /is/cv/. The CV itself is English only. */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const pdfLang = lang === 'en' ? undefined : 'en';
---
<BaseLayout title={t.cv.title} description={t.cv.description} lang={lang}>
  <section class="max-w-prose mx-auto px-6 pb-12">
    <PageHeader title={t.cv.heading} lede={t.cv.lede} />
    <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <li><a href="/cv.pdf" hreflang={pdfLang} download class="underline underline-offset-2 decoration-1 hover:decoration-2">{t.cv.short}</a></li>
      <li><a href="/cv-long.pdf" hreflang={pdfLang} download class="underline underline-offset-2 decoration-1 hover:decoration-2">{t.cv.long}</a></li>
    </ul>
  </section>
  <section class="max-w-page mx-auto px-6 pb-12">
    <object
      data="/cv.pdf"
      type="application/pdf"
      class="w-full h-[85vh] border border-rule rounded"
      aria-label={t.cv.embedLabel}
    >
      <p class="prose-body p-6">
        {t.cv.fallback}
        <a href="/cv.pdf" hreflang={pdfLang}>{t.cv.fallbackLink}</a>
      </p>
    </object>
  </section>
</BaseLayout>
